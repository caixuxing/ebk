<el-container style="height:100vh;overflow: hidden;">
    <el-main>
        <el-form label-width="100px" :inline="true">
            <div>
                <el-form-item label="订单号" prop="desc" style="margin-bottom:5px;">
                    <el-input v-model="state.qry.accountName" clearable style="width:200px"></el-input>
                </el-form-item>

                <el-form-item label="状态" prop="desc" style="margin-bottom:5px;">
                 
                     <el-select v-model="state.qry.status" placeholder="不限" style="width:220px;" clearable filterable>
                       <el-option v-for="item in state.orderSateList" :key="item.value" :label="item.describe" :value="item.value"/>
                    </el-select>

                </el-form-item>
                <el-form-item prop="desc" style="margin-bottom:5px;">
                    <el-button type="primary" v-on:click="pageIndex=1;loadData()" id="query">查询</el-button>
                    <el-button v-on:click="resetQueryForm">重置</el-button>
                </el-form-item>
            </div>
        </el-form>
        <el-form label-width="100px" :inline="true" style="margin-top:30px;">
            <el-form-item prop="desc" style="margin-bottom:5px;">
               
            </el-form-item>
        </el-form>
        <el-table :data="state.dataList"
                  border
                  height="100%" width="100%">
            <el-table-column label="#" width="60" align="center" fixed>
                <template #default="scope">
                    <div style="text-align:left">
                        <span>{{ (state.qry.pageIndex-1) * state.qry.pageSize + scope.$index +1   }}</span>
                    </div>
                </template>
            </el-table-column>
            <el-table-column label="订单号" width="120px" align="center" fixed>
                   <template #default="scope">
      @*               <label v-on:click="userEvent.onToUserHotel(scope.row)" style="color: #1890ff;cursor: pointer; "> </label> *@
                     <el-link :underline="false" type="primary" v-on:click="ViewDetail(scope.row)">{{ scope.row.orderNum }}</el-link>
                </template>
            </el-table-column>
            <el-table-column label="订单时间" width="160px" align="center">
                <template #default="scope" >
                    {{ scope.row.bookingDate }}
                </template>
            </el-table-column>
            <el-table-column label="酒店名称/间夜数" width="auto" min-width="280px" align="center" show-overflow-tooltip>
                <template #default="scope">
                    <div style="text-align:left">
                      <p>  {{ scope.row.hotelName }}</p>
                      <p>  {{ scope.row.hotelNameEn }}</p>
                       <p>  {{ scope.row.numberOfRoomsBooked }} x {{scope.row.howManyNights}}</p>
                    </div>
                </template>
            </el-table-column>
              <el-table-column label="房型/床型/餐食" width="280" mim-width="260" align="center" show-overflow-tooltip>
                <template #default="scope">
                    <div style="text-align:left">
                      <p>  {{ scope.row.roomName }}</p>
                      <p>  {{ scope.row.bedName }}</p>
                       <p>  {{ scope.row.breakfastTypeName }}</p>
                    </div>
                </template>
            </el-table-column>
            

            <el-table-column label="入店/离店" width="120" align="center">
                <template #default="scope" >
                  <p>  {{ scope.row.checkInDate }}</p>
                  <p>  {{ scope.row.checkOutDate }}</p>
                </template>
            </el-table-column>

            <el-table-column label="价格" width="auto" max-width="80px" align="center">
                <template #default="scope">
                    <div style="text-align:right">
                        {{ scope.row.totalAmount }}
                    </div>
                </template>
            </el-table-column>

            <el-table-column label="订单状态" width="120px" align="center">
                <template #default="scope">
                    <div style="text-align:center">

                        <el-tag v-show="scope.row.state==1 "  type="primary">{{  scope.row.stateName }}</el-tag>
                        <el-tag v-show="scope.row.state==0 "  type="danger">{{  scope.row.stateName }}</el-tag>

                    </div>
                </template>
            </el-table-column>
            <el-table-column label="客户姓名" width="120px" align="center">
                <template #default="scope">
                    <div style="text-align:center">
                        <span>{{  scope.row.customerName }}</span>
                    </div>
                </template>
            </el-table-column>

            <el-table-column label="酒店确认号" width="180px" align="center">
                <template #default="scope">
                    <div style="text-align:center">
                        <span>{{  scope.row.hotelConfirmNum }}</span>
                    </div>
                </template>
            </el-table-column>

            <el-table-column label="备注" width="160px" align="center">
                <template #default="scope">
                    <div style="text-align:right">
                        <p style="margin:0px;text-align:center"></p>
                    </div>
                </template>
            </el-table-column>

            <el-table-column label="操作" prop="opt" align="center" fixed="right" min-width="80" width="80">
                <template #default="scope">
                    <div style="text-align:center">
                        <el-button size="small" v-on:click="ViewDetail(scope.row)">详情</el-button>
                    </div>
                </template>
            </el-table-column>

        </el-table>
        <div style=" height:35px;padding: 10px 0px 0px 20px; ">
            <el-pagination v-model:current-page="state.qry.pageIndex"
                           v-model:page-size="state.qry.pageSize"
                           :page-sizes="[20, 50, 100,500]"
                           layout="total, sizes, prev, pager, next, jumper"
                           :total="state.qry.totalCount"
                           v-on:size-change="handleSizeChange"
                           v-on:current-change="handleCurrentChange" style="float:right;"></el-pagination>

        </div>
    </el-main>
</el-container>

@section scripts {
    <script type="text/javascript">
        const app = Vue.createApp({
        setup() {

           let qry = {  accountName: '',isEnabled: null,pageIndex: 1,pageSize: 50,totalCount: 0 }

           const state = Vue.reactive({
                qry:  qry,
                dataList: [],
                orderSateList:@(Html.Raw(ViewBag.OrderStateData)),
            });
           Vue.onMounted(() => { loadData()  });
            const loadData = () => {
                axios.post(`/Order/OrderPageList`, {...state.qry}).then(response => {
                    let {data,status}=response;
                    state.dataList = data.data.list;
                    state.qry.totalCount = data.data.total;
                })
            };

            const handleSizeChange = (val) => {
                    state.qry.pageIndex = 1;
                    state.qry.pageSize = val;
                    loadData();
            };
            const handleCurrentChange = (val) => {
                    state.qry.pageIndex = val;
                    loadData();
           };
            //重置查询表单
            const resetQueryForm=()=>{
                state.qry  = JSON.parse(JSON.stringify( qry))
             };

            const ViewDetail = (row)=>{
              
                      layer.open({
                             type: 2,
                             title: '订单详情',
                             area: ['90%', '80%'],
                             fix: false,
                             maxmin: true,
                             content:  `/Order/OrderDetail/${row.id}`,
                             end: function () {
                                loadData();
                             }
                         });


             };

            return {
                state
                ,loadData
                ,handleSizeChange
                ,handleCurrentChange
                ,resetQueryForm
                ,ViewDetail
                };
               }
            });
            app.use(ElementPlus,{ locale: ElementPlusLocaleZhCn });
            app.mount('#app');
    </script>

}