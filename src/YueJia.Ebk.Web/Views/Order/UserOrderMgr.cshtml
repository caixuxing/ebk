<el-container style="height:100vh;overflow: hidden;">
    <el-main>
        <el-form label-width="120px" :inline="true" style="margin-bottom:5px;" >

            <div>
                <el-form-item label="日期类型" prop="desc" style="margin-bottom:5px;">
                    <el-select v-model="state.qry.dateType" placeholder="不限" style="width:100px;"  >
                        <el-option label="下单日期" value="A" ></el-option>
                        <el-option  label="入住日期" value="B" ></el-option>
                        <el-option  label="离店日期" value="C" ></el-option>
                    </el-select>
                    &nbsp;
                    &nbsp;
                    <el-date-picker v-model="state.qry.startDate"
                                    type="date"
                                    style="width:130px"
                                    :clearable="false"
                                    value-format="YYYY-MM-DD"> </el-date-picker>

                    &nbsp;
                    &nbsp;
                    <el-text>至</el-text>
                    &nbsp;
                    &nbsp;

                     <el-date-picker v-model="state.qry.endDate"
                                   type="date"
                                   style="width:130px"
                                   :clearable="false"
                                   value-format="YYYY-MM-DD"> </el-date-picker>
                </el-form-item>
            </div>

            <div>
                <el-form-item label="订单单号" prop="desc" style="margin-bottom:5px;">
                    <el-input v-model="state.qry.orderNum" clearable style="width:200px"></el-input>
                </el-form-item>

                <el-form-item label="订单状态" prop="desc" style="margin-bottom:5px;">
                    <el-select v-model="state.qry.status" placeholder="不限" style="width:200px;" clearable filterable>
                       <el-option v-for="item in state.orderSateList" :key="item.value" :label="item.describe" :value="item.value"/>
                    </el-select>
                </el-form-item>

            </div>
            <div>
                <el-form-item label="酒店编码" prop="desc" style="margin-bottom:5px;">
                    <el-input v-model="state.qry.hotelCode" clearable style="width:200px"></el-input>
                </el-form-item>

                <el-form-item label="酒店名称" prop="desc" style="margin-bottom:5px;">
                    <el-input v-model="state.qry.hotelName" clearable style="width:200px"></el-input>
                </el-form-item>
            </div>

            <div>
                <el-form-item label="国家" style="margin-bottom:5px;">
                    <el-select v-model="state.qry.countryId" placeholder="不限" style="width:200px;" clearable filterable>
                        <el-option label="--不限--" :value="0"></el-option>
                        @foreach (YueJia.Ebk.Application.Contracts.Comm.BaseObj.SelectDataDto<int> ele in ViewBag.CountryList)
                        {
                            <el-option label="@ele.Label" :value="@ele.Value"></el-option>
                        }
                    </el-select>
                </el-form-item>
                <el-form-item label="城市名称" style="margin-bottom:5px;">
                    <el-input v-model="state.qry.cityName" clearable style="width:200px"></el-input>
                </el-form-item>

                <el-form-item label="用户" style="margin-bottom:5px;">
                    <el-select v-model="state.qry.userId" style="width:200px;" filterable v-on:change="pageIndex=1;loadData()">
                        @foreach (YueJia.Ebk.Application.Contracts.SysUserApp.Dto.SysUserDetailsDto ele in ViewBag.GetManageUserList)
                        {
                            <el-option label="@ele.RealName" value="@ele.Id.ToString()"></el-option>
                        }
                    </el-select>
                </el-form-item>

                <el-form-item prop="desc" style="margin-bottom:5px;">
                    <el-button type="primary" v-on:click="pageIndex=1;loadData()" id="query">查询</el-button>
                    <el-button v-on:click="resetQueryForm">重置</el-button>
                </el-form-item>

            </div>
        </el-form>
  
        <el-table :data="state.dataList"
                  border
                  height="100%" width="100%">
            <el-table-column label="#" width="60" align="center" fixed>
                <template #default="scope">
                    <div style="text-align:left">
                        <span>{{ (state.qry.pageIndex-1) * state.qry.pageSize + scope.$index +1   }}</span>
                    </div>
                </template>
            </el-table-column>
            <el-table-column label="订单号" width="180px" align="center" fixed>
                   <template #default="scope">
                     <el-link :underline="false" type="primary" v-on:click="ViewDetail(scope.row)">{{ scope.row.orderNum }}</el-link>
                </template>
            </el-table-column>

            <el-table-column label="国家/城市" width="160px" align="center" >
                <template #default="scope">
                   <div style="text-align:left" >
                        <el-text>{{ scope.row.countryName }}</el-text>
                   </div>
                    <div style="text-align:left">
                        <el-text>{{ scope.row.cityName }}</el-text>
                    </div>
                </template>
            </el-table-column>

            <el-table-column label="酒店编码" width="120" align="center">
                <template #default="scope">
                    <el-text>{{ scope.row.hotelCode }}</el-text>
                </template>
            </el-table-column>
            <el-table-column label="酒店名称" min-width="220px" width="auto" align="center" show-overflow-tooltip>
                <template #default="scope">
                    <div style="text-align:left">
                        <el-text>{{ scope.row.hotelName }}</el-text>
                    </div>
                    <div style="text-align:left">
                        <el-text>{{ scope.row.hotelNameEn }}</el-text>
                    </div>
                </template>
            </el-table-column>

            <el-table-column label="入店/离店" width="100" align="center">
                <template #default="scope">
                    <p>  {{ scope.row.checkInDateString }}</p>
                    <p>  {{ scope.row.checkOutDateString }}</p>
                </template>
            </el-table-column>

            <el-table-column label="间夜数" width="100"  align="center">
                <template #default="scope">
                        <el-text>{{ scope.row.roomNumber }}/{{ scope.row.howManyNights }}</el-text>
                </template>
            </el-table-column>

            <el-table-column label="金额" width="100" align="center">
                <template #default="scope">
                    <div style="text-align:right" >
                        <el-text>{{ scope.row.costAmount }}</el-text>
                    </div>
                </template>
            </el-table-column>

            <el-table-column label="订单状态" width="100px" align="center">
                <template #default="scope">
                    <div style="text-align:center">
                        <el-tag  type="primary">{{  scope.row.stateName }}</el-tag>
                    </div>
                </template>
            </el-table-column>
            <el-table-column  align="center"  width="80">
                <template #default="scope">
                    <div style="text-align:center">
                        <el-button size="small" v-on:click="ViewDetail(scope.row)">详情</el-button>
                    </div>
                </template>
            </el-table-column>

        </el-table>
        <div style=" height:35px;padding: 10px 0px 0px 20px; ">
            <el-pagination v-model:current-page="state.qry.pageIndex"
                           v-model:page-size="state.qry.pageSize"
                           :page-sizes="[20, 50, 100,500]"
                           layout="total, sizes, prev, pager, next, jumper"
                           :total="state.qry.totalCount"
                           v-on:size-change="handleSizeChange"
                           v-on:current-change="handleCurrentChange" style="float:right;"></el-pagination>

        </div>
    </el-main>
</el-container>

@section scripts {
    <script type="text/javascript">
        const app = Vue.createApp({
        setup() {

           let qry = {  
                        dateType:'A',
                        startDate:'@DateTime.Now.ToString("yyyy-MM-dd")',
                        endDate:'@DateTime.Now.ToString("yyyy-MM-dd")',
                        orderNum: '',
                        hotelCode:'',
                        hotelName:'',
                        isEnabled: null,
                        pageIndex: 1,
                        pageSize: 50,
                        totalCount: 0 ,
                        countryId:null,
                        cityName:'', 
                        userId:'@ViewBag.UserId'}

           const state = Vue.reactive({
                qry: JSON.parse(JSON.stringify( qry)),
                dataList: [],
                orderSateList:@(Html.Raw(ViewBag.OrderStateData)),
            });
           Vue.onMounted(() => { loadData()  });

            const loadData = () => {
                axios.post(`/Order/OrderPageList`, {...state.qry}).then(response => {
                    let {data,status}=response;
                    state.dataList = data.data.list;
                    state.qry.totalCount = data.data.total;
                })
            };

            const handleSizeChange = (val) => {
                    state.qry.pageIndex = 1;
                    state.qry.pageSize = val;
                    loadData();
            };
            const handleCurrentChange = (val) => {
                    state.qry.pageIndex = val;
                    loadData();
           };
            //重置查询表单
            const resetQueryForm=()=>{
                console.log('dd');
                state.qry  = JSON.parse(JSON.stringify( qry))
             };

            const ViewDetail = (row)=>{
              
                      layer.open({
                             type: 2,
                             title: '订单详情',
                             area: ['90%', '80%'],
                             fix: false,
                             maxmin: true,
                             content:  `/Order/OrderDetail?orderId=${row.id}`,
                             end: function () {
                                loadData();
                             }
                         });


             };

            return {
                state
                ,loadData
                ,handleSizeChange
                ,handleCurrentChange
                ,resetQueryForm
                ,ViewDetail
                };
               }
            });
            app.use(ElementPlus,{ locale: ElementPlusLocaleZhCn });
            app.mount('#app');
    </script>

}