<div class="login-container" >
	<el-card class="login-card">
		<h2 class="login-title">Ebk-登录</h2>
		<el-form :model="state" ref="loginRef" :rules="loginRules">
			<el-form-item prop="AccountNo">
				<el-input v-model="state.AccountNo" autocomplete="off" placeholder="账户" clearable v-on:keyup.enter=" setPwdFocus"  />
			</el-form-item>
			<el-form-item prop="AccountPwd">
				<el-input v-model="state.AccountPwd" type="password" show-password clearable placeholder="密码" class="AccountPwd" v-on:keyup.enter=" setSubmit"  />
			</el-form-item>
			<el-form-item>
				<el-button type="primary" v-on:click="handleLogin" >登录</el-button>
			</el-form-item>
		</el-form>
	</el-card>
</div>

@section scripts {
	<script setup type="text/javascript">
		const app = Vue.createApp({
			setup() {
				const state = Vue.reactive({
					AccountNo: "@ViewBag.UserNmae",
					AccountPwd: "@ViewBag.Password"
				});

				const loginRef = Vue.ref(null);
				const loginRules = {
					AccountNo: [{ required: true, message: '登录账户必填', trigger: 'blur' }],
					AccountPwd: [{ required: true, message: '登录密码必填', trigger: 'blur' }]
				};

				const setPwdFocus  =() => {
				  if(state.AccountNo){
					  $(".AccountPwd input").focus()
				  }
				}

				const setSubmit =() => {
					  if(state.AccountPwd){
						   handleLogin();
					  }
				}

				const handleLogin =() => {
					loginRef.value.validate((valid) => {
						if (!valid) {
						 return;
						}
						axios.post('/login', { userName: state.AccountNo, passWord: state.AccountPwd })
						.then((response) => {
							if (response.data.isSuccess) {
								window.location.href = `${response.data.data}`;
								return;
							}
							ElMessage.error(response.data.message);
						})
				
					  });
				};

				Vue.onMounted(() => {
					loginRef.value?.resetFields();
				});
				return {
					state,
					handleLogin,
					loginRules,
					loginRef,
					setPwdFocus,
					setSubmit
				};
			}
		});
		app.use(ElementPlus);
		app.mount('#app');
	</script>
}

@section head {
	<style scoped>
		.login-container {
			display: flex;
			justify-content: center;
			align-items: center;
			height: 100vh;
		}

		.login-card {
			width: 400px;
		}

		.login-title {
			color: rgb(71, 143, 202) !important;
			width: 100%;
			padding: 10px 0px;
			border-bottom: 1px solid #e4e7ed;
		}

		.el-form {
			margin-top: 30px;
		}

		.el-input {
			width: 100%;
			height: 40px;
		}

		.el-button {
			width: 100%;
			height: 40px;
			border-radius: 20px;
			/* 	background: #de2910;
					border: #de2910; */
			margin-top: 20px;
		}

		body {
			background-color: #1D2024;
		}

	</style>
}
