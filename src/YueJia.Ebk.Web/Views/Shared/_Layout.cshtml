@using YueJia.Ebk.Application.Contracts.SysUserApp
<!DOCTYPE html>
@inject IHostEnvironment env
@inject ICurrentUserApp CurrentUserApp
<html lang="en">
<head>
    <title>
        EBK  @string.Format("{0}{1}", $"-{env.EnvironmentName}", $"{(string.IsNullOrWhiteSpace(CurrentUserApp.Company?.CompanyName)  ? "" : "-【" + CurrentUserApp.Company?.CompanyName + "】")}")
    </title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Import style -->
    <link href="~/element-plus/index.css" rel="stylesheet" />
    <!-- Import Vue 3 -->
    <script src="~/js/vue.global.js"></script>

    <!-- Import component library -->
 
    <script src="~/element-plus/index.full.js"></script>
    <script src="~/element-plus/zh-cn.js"></script>
    <script src="~/js/axios.min.js"></script>
    <script src="~/js/jquery-3.3.1.min.js"></script>
    <style>
        body {
            font-family: "Helvetica Neue",Helvetica,Arial,sans-serif;
            font-size: 14px;
            line-height: 1.42857143;
            color: #333;
            margin: 0px;
            overflow: hidden;
        }
        [v-cloak] {
            display: none !important;
        }
        .lspan {
            color: black !important;
        }

        .el-main {
            display: inline-flex;
            flex-grow: 1;
            flex-direction: column;
            border: #ebeef5 1px solid;
            overflow: hidden;
            height: 100%;
            width: 100%;
            padding: 10px !important;
            margin: 0px;
            border: none;
        }

        .el-table {
            flex-grow: 1;
          /*   display: flex; */
            overflow: auto;
            height: 1px;
        }
        .el-table__empty-block {
       width: 100% !important;
   }

    </style>
    @await RenderSectionAsync("head",false)
</head>
<body>
    <div id="app" class="element-main" v-cloak>
        @RenderBody()
    </div>
</body>
<link href="~/layui/layui.css" rel="stylesheet" />
<!-- 引入 layui.css -->
<!-- 引入 layui.js -->
<script src="~/layui/layui.js"></script>

<script type="text/javascript">

    /*
    * 发送前    
    */
    axios.interceptors.request.use(function (config) {
        
        layer.load();

        return config;
    }, function (error) {
        // 对请求错误做些什么
        return Promise.reject(error);
    });


    /*
    * 返回
    */
         axios.interceptors.response.use(function (response) {

            layer.closeAll('loading'); //关闭加载层

             // 对响应数据做点什么
             return response;
        },
        error => {

              layer.closeAll('loading'); //关闭加载层

            if (error.response  && !error.response.data.isSuccess  && [400, 500].includes(error.response.status))  {
                ElMessage.error(error.response.data.message); 
                return;
            }
            else if (error.response && error.response.status === 401) {
                ElMessage({ message: error.response.data.message, type: error.response.data.messageType });
                top.location.href = "/";
            } else {
                ElMessage.error('请求响应异常,请联系管理员!')
            }
            return Promise.reject(error);
        }
    );

    const { ElMessage, ElMessageBox, ElLoading } = ElementPlus;
</script>
@await RenderSectionAsync("scripts", false)
</html>
