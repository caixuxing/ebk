@model YueJia.Ebk.Web.ViewModels.Hotel.RoomAndPricePlanVo
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section head {
    <style type="text/css">
        .hide-body .el-card__body {
          display: none !important;
          padding: 0 !important;
        }
 </style>
}
<el-container style="height:100vh;overflow: hidden;">
    <el-main>

       @Html.Partial("~/Views/Hotel/UserHotelNavigationMgr.cshtml", (@ViewBag.mv as YueJia.Ebk.Web.ViewModels.Hotel.ViewHotelVo))
       
       <div style="height:50px;line-height:50px; position:relative ">
            <h1>房间与价格计划</h1>
            <el-button type="primary" v-on:click="onAddRoom" size="small" style="position: absolute;top: 13px;left:170px;">新增房间</el-button>
       </div>

        <el-divider content-position="left"></el-divider>

        <el-scrollbar>
          <el-card v-for="(item, index) in vmodel.roomList"  :class="{ 'hide-body': !item.showContent }"  style=" margin-bottom:20px "   >
            <template #header>
                @* 头部信息 *@
                    <el-tag type="success">{{item.isEnabledName}} </el-tag>
                    <div style="display: inline-block;margin-left:20px;width:600px;">
                        <el-link :underline="false" >{{item.roomTypeName}}</el-link>
                        <el-link :underline="false" >==></el-link>
                        <el-link :underline="false" >{{item.bedTypeName}}</el-link>
                    </div>

                    <el-button size="small" v-on:click="onDeleteRoom(item)" type="danger">删除</el-button>
                    <el-button size="small" v-on:click="onSwitchRoomState(item)">切换状态</el-button>
                    <el-button size="small" v-on:click="onAddPricePlan(item)">新增价格计划</el-button>


                    <el-link :underline="false" style="margin-left:20px" v-if="item.showContent == false" v-on:click="item.showContent = true">显示更多详情</el-link>
                    <el-link :underline="false" style="margin-left:20px" v-if="item.showContent ==true "  v-on:click="item.showContent = false">隐藏更多详情</el-link>

                    <el-link :underline="false" style="margin-left:20px" v-if="item.showFooter == false" v-on:click="item.showFooter = true">显示价格计划</el-link>
                    <el-link :underline="false" style="margin-left:20px" v-if="item.showFooter ==true " v-on:click="item.showFooter = false">隐藏价格计划</el-link>
            </template>

            <div v-if="item.showContent">
                    @* 详情信息 *@
                    <el-form label-width="auto" :inline="true">
                        <div>
                            <el-form-item label="床型">
                                <label>{{item.bedTypeName}}</label>
                            </el-form-item>
                        </div>
                        <div>
                            <el-form-item label="人数上限">
                                <label>{{item.maximumNumberOfPeople}}</label>
                            </el-form-item>
                            <el-form-item label="成人上限">
                                <label>{{item.adultLimit}}</label>
                            </el-form-item>
                            <el-form-item label="儿童上限">
                                <label>{{item.childLimit}}</label>
                            </el-form-item>
                        </div>
                    </el-form>
            </div>
                <template #footer v-if="item.showFooter" >

                    <el-table :data="item.pricePlans"
                               border
                               height="100%" >


                        <el-table-column label="描述" width="auto" align="center">
                            <template #default="scope">
                                <div style="text-align:left" >
                                    {{item.roomTypeName}}
                                    <{{scope.row.breakfastTypeName}}>
                                    <提前{{scope.row.daysInAdvance}}天>
                                    <连住{{scope.row.continuousStayDays}}天>
                                </div>
                            </template>
                        </el-table-column>
                        
                        <el-table-column label="是否保留房" width="150px" align="center">
                            <template #default="scope">
                                <div style="text-align:center">
                                    <span>{{  scope.row.isReservedRoomName }}</span>
                                </div>
                            </template>
                        </el-table-column>

                        <el-table-column label="状态"  width="150px" align="center">
                            <template #default="scope">
                                <div style="text-align:center">
                                    <span>{{  scope.row.isEnableName }}</span>
                                </div>
                            </template>
                        </el-table-column>

                        <el-table-column label="操作" width="180px" align="center">
                            <template #default="scope">
                                    <el-button size="small" v-on:click="onSwitchPricePlanState(scope.row)">切换状态</el-button>
                                    <el-button size="small" type="danger" v-on:click="onDeletePricePlan(scope.row)">删除 </el-button>
                            </template>
                        </el-table-column>

                    </el-table>

            </template>
          </el-card>
       </el-scrollbar>
    </el-main>
</el-container>
@section scripts {
    <script type="text/javascript">
        const app = Vue.createApp({
        setup() {

           const vmodel = Vue.reactive({
                roomList : [],
           });

           Vue.onMounted(() => {
              loadData();
           
              console.log(@Model.Id);
              console.log(@Model.Id.ToString());
           
           });



        /**
         * 新增房间
         */
          const onAddRoom=()=>{
                    layer.open({
                        type: 2,
                        title: '新增房间',
                        area: ['90%', '80%'],
                        fix: false,
                        maxmin: true,
                        content:  "/Hotel/AddHotelRoom?id=@ViewBag.mv.Id",
                        end: function () {
                           loadData();
                        }
                    });
          }

          /**
           * 新增价格计划
           */
          const onAddPricePlan =(row)=>{
                    layer.open({
                        type: 2,
                        title: '新增价格计划',
                        area: ['90%', '80%'],
                        fix: false,
                        maxmin: true,
                        content:  `/Hotel/AddPricePlan/${row.id}`,
                        end: function () {
                           loadData();
                        }
                    });
          }

         /**
          * 切换房间 状态
          */
          const onSwitchRoomState = (row)=>{
                ElMessageBox.confirm('您确定切换房间状态吗?', { confirmButtonText: '确定', cancelButtonText: '取消', type: 'warning', }).then(() => {
                         axios.post(`/Hotel/UpdateRoomState/${row.id}`).then(res  => {
                              top.window.vueElMessage({ message: res.data. message , type:  res.data.isSuccess?'success':'info' })
                                      if(res.data.isSuccess){
                                         loadData();
                                      }
                        })
                 })
          }

            /**
             * 删除房间
             */
            const onDeleteRoom=(row)=> {
                 ElMessageBox.confirm('您确定删除吗?', { confirmButtonText: '确定', cancelButtonText: '取消', type: 'warning', }).then(() => {
                         axios.delete(`/Hotel/DeleteHotelRoom/${row.id}/`).then(res  => {
                              top.window.vueElMessage({ message: res.data. message , type:  res.data.isSuccess?'success':'info' })
                                      if(res.data.isSuccess){
                                         loadData();
                                      }
                        })
                 })
            };



            /**
             * 删除价格计划
             */
            const onDeletePricePlan=(row)=>{
                 ElMessageBox.confirm('您确定删除吗?', { confirmButtonText: '确定', cancelButtonText: '取消', type: 'warning', }).then(() => {
                         axios.delete(`/Hotel/DeletePricePlan/${row.id}`).then(res  => {
                              top.window.vueElMessage({ message: res.data. message , type:  res.data.isSuccess?'success':'info' })
                                      if(res.data.isSuccess){
                                         loadData();
                                      }
                        })
                 })
            };

            /**
             * 切换PricePlan 状态
             */
            const onSwitchPricePlanState =(row)=>{
                ElMessageBox.confirm('您确定切换价格计划状态吗?', { confirmButtonText: '确定', cancelButtonText: '取消', type: 'warning', }).then(() => {
                         axios.post(`/Hotel/UpdatePricePlanState/${row.id}`).then(res  => {
                              top.window.vueElMessage({ message: res.data. message , type:  res.data.isSuccess?'success':'info' })
                                      if(res.data.isSuccess){
                                         loadData();
                                      }
                        })
                 })
            }
             


            const loadData = () => {
                       axios.get(`/Hotel/RoomAndPricePlanList/@Model.Id`).then(response => {
                         let {data,status}=response;
                         vmodel.roomList = data.data;
                     })
             };
          return {
              vmodel
              ,onAddRoom
              ,onAddPricePlan
              ,onDeleteRoom
              ,onSwitchRoomState
              ,onDeletePricePlan
              ,onSwitchPricePlanState
          }

        }
        });
        app.use(ElementPlus);
        app.mount('#app');
    </script>
}


