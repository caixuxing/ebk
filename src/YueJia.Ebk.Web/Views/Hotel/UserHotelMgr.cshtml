<el-container style="height:100vh;overflow: hidden;">
    <el-main>
        <el-form label-width="auto" :inline="true">
            <div>
                <el-form-item label="酒店编码" style="margin-bottom:5px;">
                    <el-input v-model="state.qry.hotelCode" clearable style="width:200px"></el-input>
                </el-form-item>
                <el-form-item label="酒店名称" style="margin-bottom:5px;">
                    <el-input v-model="state.qry.hotelName" clearable style="width:200px"></el-input>
                </el-form-item>
                <el-form-item label="状态"  style="margin-bottom:5px;">
                    <el-select v-model="state.qry.status" placeholder="不限" style="width:220px;" clearable filterable>
                       <el-option v-for="item in state.saleTypeData" :key="item.value" :label="item.describe" :value="item.value"/>
                    </el-select>
                </el-form-item>


                <el-form-item prop="desc" style="margin-bottom:5px;">
                    <el-button type="primary" v-on:click="pageIndex=1;userEvent.loadData()" id="query">查询</el-button>
                    <el-button v-on:click="userEvent.onResetQueryForm">重置</el-button>
                </el-form-item>
            </div>
            <div>
                <el-form-item label="国家" style="margin-bottom:5px;">
                    <el-select v-model="state.qry.countryId" placeholder="不限" style="width:200px;" clearable filterable>
                        <el-option label="--不限--" :value="0"></el-option>
                        @foreach (YueJia.Ebk.Application.Contracts.Comm.BaseObj.SelectDataDto<int> ele in ViewBag.CountryList)
                        {
                            <el-option label="@ele.Label" :value="@ele.Value"></el-option>
                        }
                    </el-select>
                </el-form-item>
                <el-form-item label="城市名称" style="margin-bottom:5px;">
                    <el-input v-model="state.qry.cityName" clearable style="width:200px"></el-input>
                </el-form-item>
            </div>
        </el-form>
        <el-form label-width="100px" :inline="true" style="margin-top:30px;">
            <el-form-item prop="desc" style="margin-bottom:5px;">
                <el-button v-on:click="userEvent.onBatchUp">批量上架</el-button>
                <el-button v-on:click="userEvent.onBatchDown">批量下架</el-button>
                <el-button type="primary" v-on:click="userEvent.onAddUserHotel">添加酒店</el-button>
            </el-form-item>
        </el-form>
        <el-table :data="state.dataList"
                  border
                  v-on:selection-change ="handleSelectionChange"
                  height="100%" >

            <el-table-column type="selection" width="50" align="center"></el-table-column>
            <el-table-column label="#" width="60" align="center">
                <template #default="scope">
                    <div style="text-align:left">
                        <span>{{ (state.qry.pageIndex-1) * state.qry.pageSize + scope.$index +1   }}</span>
                    </div>
                </template>
            </el-table-column>
            <el-table-column label="酒店编码" width="110px" align="center"  >
                <template #default="scope">
                    <label v-on:click="userEvent.onToUserHotel(scope.row)" style="color: #1890ff;cursor: pointer; ">{{ scope.row.hotelCode }}</label>
                </template>
            </el-table-column>
            <el-table-column label="酒店名称" width="300px" align="center" show-overflow-tooltip >
                <template #default="scope">
                    <div style="text-align:left" >
                        <p style="margin:5px 0px">{{ scope.row.hotelName }}</p>
                        <p>{{ scope.row.hotelNameEn }}</p>
                    </div>
             
                </template>
            </el-table-column>
            <el-table-column label="酒店地址" width="auto" max-width="200px" align="center" show-overflow-tooltip >
                <template #default="scope">
                    <div style="text-align:left" >
                        <p>[{{scope.row.countryIosCode}}]{{scope.row.countryName}},{{scope.row.cityName}}</p>
                        <p>{{ scope.row.addressEn }}</p>
                    </div>
                </template>
            </el-table-column>
            <el-table-column label="联系电话" width="150px" align="center"  >
                <template #default="scope" >
                    <div style="text-align:left" >
                        {{ scope.row.telPhone }}
                    </div>
                </template>
            </el-table-column>

             <el-table-column label="销售状态" width="90px" align="center">
                <template #default="scope">
                    <div style="text-align:">
                        <el-tag v-show="scope.row.status==1 "  type="primary">{{  scope.row.statusName }}</el-tag>
                        <el-tag v-show="scope.row.status==2 "  type="danger">{{  scope.row.statusName }}</el-tag>
                    </div>
                </template>
            </el-table-column>
            <el-table-column label="用户名称" width="120px" align="center" show-overflow-tooltip >
                <template #default="scope"   >
                    <div style="text-align:left">
                        <span>{{  scope.row.realName }}</span>
                    </div>
                </template>
            </el-table-column>

            <el-table-column label="操作" prop="opt" width="220px" align="center">
                <template #default="scope">
                    <div style="text-align:center">
                        <el-button size="small" v-on:click="userEvent.onChangeUserHotelState(scope.row)">切换状态</el-button>
                        <el-button size="small" v-on:click="userEvent.onToUserHotel(scope.row)">查看</el-button>
                        <el-button size="small" type="danger" v-on:click="userEvent.onDeleteUserHotel(scope.row)">删除 </el-button>
                    </div>
                </template>
            </el-table-column>

        </el-table>
        <div style=" height:35px;padding: 10px 0px 0px 20px; ">
            <el-pagination v-model:current-page="state.qry.pageIndex"
                           v-model:page-size="state.qry.pageSize"
                           :page-sizes="[20, 50, 100,500]"
                           layout="total, sizes, prev, pager, next, jumper"
                           :total="state.qry.totalCount"
                           v-on:size-change="handleSizeChange"
                           v-on:current-change="handleCurrentChange" style="float:right;"></el-pagination>

        </div>
    </el-main>
</el-container>





@section scripts {
    <script type="text/javascript">
        const app = Vue.createApp({
        setup() {

           let qry = {  hotelCode: '',hotelName: '',countryId:null,cityName:'', status: null,pageIndex: 1,pageSize: 50,totalCount: 0 }
           let selectUserHotelIds = [];
           const state = Vue.reactive({
                qry:  JSON.parse(JSON.stringify( qry)),
                saleTypeData:@(Html.Raw(ViewBag.HotelSaleTypeData)),
                dataList: []
            });

            Vue.onMounted(() => { userEvent.loadData()  });

             const handleSizeChange = (val) => {
                     state.qry.pageIndex = 1;
                     state.qry.pageSize = val;
                    userEvent. loadData();
             };
             const handleCurrentChange = (val) => {
                     state.qry.pageIndex = val;
                    userEvent. loadData();
            };

            const handleSelectionChange = (rows) => {
                 selectUserHotelIds = rows.map(vv=>vv.id+'');
            }


               const userEvent ={
                   /**
                    * 分页数据
                    */
                   loadData:()=>{
                       axios.post(`/hotel/UserHotelPage`, {...state.qry}).then(response => {
                         let {data,status}=response;
                         state.dataList = data.data.list;
                          state.qry.totalCount = data.data.total;
                     })
                   },
                   /**
                    * 跳转酒店
                    */
                   onToUserHotel:(row)=>{
                        window.location.href =`/Hotel/UserHotelDetails/${row.id}`
                   },
                   /**
                    * 重置查询条件
                    */
                   onResetQueryForm:()=>{
                     state.qry  = JSON.parse(JSON.stringify( qry))
                   },
                   /**
                    * 删除用户酒店
                    */
                   onDeleteUserHotel:(row)=>{
                        ElMessageBox.confirm('您确定删除吗?', { confirmButtonText: '确定', cancelButtonText: '取消', type: 'warning', }).then(() => {
                            axios.post(`/hotel/UserHotelDelete/${row.id}`).then(res => {
                                              top.window.vueElMessage({ message: res.data. message , type:  res.data.isSuccess?'success':'info' })
                                              if(res.data.isSuccess){
                                                state.qry.pageIndex=1
                                                userEvent.loadData();
                                              }
                                })
                        })
                   },
                   /**
                    * 切换状态
                    */
                   onChangeUserHotelState:(row)=>{
                        ElMessageBox.confirm('您确定切换酒店状态吗?', { confirmButtonText: '确定', cancelButtonText: '取消', type: 'warning', }).then(() => {
                                 axios.post(`/Hotel/UserHotelChangeState/${row.id}`).then(res  => {
                                      top.window.vueElMessage({ message: res.data. message , type:  res.data.isSuccess?'success':'info' })
                                              if(res.data.isSuccess){
                                              userEvent.   loadData();
                                              }
                                })
                         })
                   },
                    /**
                     * 批量上架
                     */
                   onBatchUp:()=>{
                        if(selectUserHotelIds.length == 0){
                            top.window.vueElMessage({ message: '请选择操作项' , type:  'info' })
                            return;
                        }
                        ElMessageBox.confirm('您确定批量上架吗?',{ confirmButtonText: '确定', cancelButtonText: '取消', type: 'warning', }).then(() => {
                            axios.post(`/hotel/UserHotelBatchUp`,selectUserHotelIds).then(res => {
                                              top.window.vueElMessage({ message: res.data. message , type:  res.data.isSuccess?'success':'info' })
                                              if(res.data.isSuccess){
                                                userEvent. loadData();
                                              }
                                })
                        })
                   },
                   /**
                    * 批量下架
                    */
                   onBatchDown:()=>{
                        if(selectUserHotelIds.length == 0){
                            top.window.vueElMessage({ message: '请选择操作项' , type:  'info' })
                            return;
                        }
                        ElMessageBox.confirm('您确定批量下架吗?', { confirmButtonText: '确定', cancelButtonText: '取消', type: 'warning', }).then(() => {
                            axios.post(`/hotel/UserHotelBatchDown`,selectUserHotelIds).then(res => {
                                              top.window.vueElMessage({ message: res.data. message , type:  res.data.isSuccess?'success':'info' })
                                              if(res.data.isSuccess){
                                                userEvent. loadData();
                                              }
                                })
                        })
                   },
                   /**
                    * 添加酒店
                    */
                   onAddUserHotel:()=>{
                        layer.open({
                             type: 2,
                             title: '添加酒店',
                             area: ['90%', '80%'],
                             fix: false,
                             maxmin: true,
                             content:  "/Hotel/AddUserHotelMgr",
                             end: function () {
                                state.qry.pageIndex = 1;
                                userEvent. loadData();
                             }
                         });
                   }
               }

                return {
                        state
                        ,userEvent
                        ,handleSizeChange
                        ,handleCurrentChange
                        ,handleSelectionChange
                    }
            }});
            app.use(ElementPlus,{ locale: ElementPlusLocaleZhCn });
            app.mount('#app');
    </script>

}