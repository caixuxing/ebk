@using YueJia.Ebk.Application.Contracts.SysApp
@using YueJia.Ebk.Web.ViewModels.Hotel
@using YueJia.Ebk.Application.Contracts.HotelApp.Dto
@model YueJia.Ebk.Application.Contracts.HotelApp.Dto.LoadingInventoryAndPricesDto
@inject ISysEnumApp enumApp
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section head {
    <title>批量加载库存与价格</title>
    <style scoped>
        .el-input-number .el-input__inner{
        text-align:left !important;
        }
    </style>
}
<el-container style="height:100vh;overflow: hidden;">
    <el-main>
        <el-scrollbar>
        <el-form :model="state.formData" label-width="auto" :rules="FormDataRules" ref="FormDataRef">
            @await Html.PartialAsync("~/Views/Hotel/UserHotelNavigationMgr.cshtml", new ViewHotelVo { Id = Model.HotelId, HotelName = Model.HotelName })
            <el-form-item style="margin-top:30px">
                    <h1>批量加载库存与价格</h1>
            </el-form-item>
            <el-form-item label="酒店：">
                <el-text class="mx-1">{{state.formData.hotelName}}</el-text>
            </el-form-item>
            <el-form-item label="房型名称：">
                              

                 <el-select v-model="selectedLoadRoomValues"  multiple clearable   placeholder="请选择房型" popper-class="custom-header" >
                    <template #header>
                      <el-checkbox v-model="checkAll":indeterminate="indeterminate" v-on:change="handleCheckAll" >
                        全选
                      </el-checkbox>
                    </template>
                    <el-option v-for="item in state.roomDropdown" :key="item.value" :label="item.label" :value="item.value" ></el-option>
                  </el-select>

            </el-form-item>

            <el-form-item label="截至日期：">
                    <el-date-picker v-model="state.formData.endDate" type="date" placeholder="截至日期"   value-format="YYYY-MM-DD"
  format="YYYY-MM-DD"> </el-date-picker>
            </el-form-item>


                <el-form-item>
                   <el-radio-group v-model="state.formData.roomId" v-on:change="handleRoomChange">
                      <el-radio-button v-for="option in filteredRooms" :label="option.label" :value="option.value" ></el-radio-button>
                    </el-radio-group>
            </el-form-item>
              

            <el-alert v-if="state.formData.roomId!=''" title="成本价若不填写，则系统自动以默认价格填入且不售卖，相应日期默认为关房；若选中不同房型，请切换房型进行编辑" type="warning" :closable="false" show-icon></el-alert>

           <el-divider content-position="left" v-if="state.formData.roomId!=''">库存设置</el-divider>
            <el-form-item v-if="state.formData.roomId!=''">
                <div class="el-table--fit el-table--border el-table--scrollable-y el-table--enable-row-hover el-table el-table--layout-fixed is-scrolling-none" data-prefix="el" style="width: 100%; height: 89px;">
                    <div class="el-table__inner-wrapper">

                        <table class="el-table__header" border="0" cellpadding="0" cellspacing="0" style="width: 100%;">
                            <thead>
                                <tr>
                                    <th class="el-table__cell" colspan="1" rowspan="1"><div class="cell" style="text-align:center">批量编辑</div></th>
                                    <th class="el-table__cell" colspan="1" rowspan="1"><div class="cell" style="text-align:center">星期天</div></th>
                                    <th class="el-table__cell" colspan="1" rowspan="1"><div class="cell" style="text-align:center">星期一</div></th>
                                    <th class="el-table__cell" colspan="1" rowspan="1"><div class="cell" style="text-align:center">星期二</div></th>
                                    <th class="el-table__cell" colspan="1" rowspan="1"><div class="cell" style="text-align:center">星期三</div></th>
                                    <th class="el-table__cell" colspan="1" rowspan="1"><div class="cell" style="text-align:center">星期四</div></th>
                                    <th class="el-table__cell" colspan="1" rowspan="1"><div class="cell" style="text-align:center">星期五</div></th>
                                     <th class="el-table__cell" colspan="1" rowspan="1"><div class="cell" style="text-align:center">星期六</div></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="el-table__row">
                                    <td class="el-table__cell" colspan="1" rowspan="1"><div class="cell" style="text-align:center"><el-input-number v-model="currentRoom.inventoryBatchSet" :controls="false" style="width:80px" :min="0" :max="100000"  v-on:input="handleInputChange"></el-input-number></div></td>
                                    <td class="el-table__cell" colspan="1" rowspan="1"><div class="cell" style="text-align:center"><el-input-number v-model="currentRoom.inventory.Sunday" :controls="false" style="width:80px" :min="0" :max="100000"  ></el-input-number></div></td>
                                    <td class="el-table__cell" colspan="1" rowspan="1"><div class="cell" style="text-align:center"> <el-input-number v-model="currentRoom.inventory.Monday" :controls="false" style="width:80px" :min="0" :max="100000"></el-input-number></div></td>
                                    <td class="el-table__cell" colspan="1" rowspan="1"><div class="cell" style="text-align:center"> <el-input-number v-model="currentRoom.inventory.Tuesday" :controls="false" style="width:80px" :min="0" :max="100000"></el-input-number></div></td>
                                    <td class="el-table__cell" colspan="1" rowspan="1"><div class="cell" style="text-align:center"> <el-input-number v-model="currentRoom.inventory.Wednesday" :controls="false" style="width:80px" :min="0" :max="100000"></el-input-number></div></td>
                                    <td class="el-table__cell" colspan="1" rowspan="1"><div class="cell" style="text-align:center"> <el-input-number v-model="currentRoom.inventory.Thursday" :controls="false" style="width:80px" :min="0" :max="100000"></el-input-number></div></td>
                                    <td class="el-table__cell" colspan="1" rowspan="1"><div class="cell" style="text-align:center"> <el-input-number v-model="currentRoom.inventory.Friday" :controls="false" style="width:80px" :min="0" :max="100000"></el-input-number></div></td>
                                    <td class="el-table__cell" colspan="1" rowspan="1"><div class="cell" style="text-align:center"> <el-input-number v-model="currentRoom.inventory.Saturday" :controls="false" style="width:80px" :min="0" :max="100000"></el-input-number></div></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                </div>
            </el-form-item>

       <el-divider content-position="left" v-if="state.formData.roomId!=''">价格设置</el-divider>
     
       <div v-if="state.formData.roomId!=''" class="el-table--fit el-table--border el-table--scrollable-y el-table--enable-row-hover el-table el-table--layout-fixed is-scrolling-none" data-prefix="el" 
       style="width: 100%; height:100%; margin-bottom:30px;"   
       
       v-for="(item,index) in  currentRoom.prices">
                    <div class="el-table__inner-wrapper" >

                        <table class="el-table__header" border="0" cellpadding="0" cellspacing="0" style="width: 100%" >
                            <thead>
                                <tr><th class="el-table__cell" colspan="9"> <div class="cell"> {{item.pricePlanName}}
                                     <el-tag :type="item.status==1?'success':'danger'" style="margin-left:20px">{{item.statusName}} </el-tag>
                                </div></th></tr>
                                <tr>
                                    <th class="el-table__cell" colspan="1" rowspan="1"><div class="cell"></div></th>
                                    <th class="el-table__cell" colspan="1" rowspan="1"><div class="cell" style="text-align:center">批量编辑</div></th>
                                    <th class="el-table__cell" colspan="1" rowspan="1"><div class="cell" style="text-align:center">星期天</div></th>
                                    <th class="el-table__cell" colspan="1" rowspan="1"><div class="cell" style="text-align:center">星期一</div></th>
                                    <th class="el-table__cell" colspan="1" rowspan="1"><div class="cell" style="text-align:center">星期二</div></th>
                                    <th class="el-table__cell" colspan="1" rowspan="1"><div class="cell" style="text-align:center">星期三</div></th>
                                    <th class="el-table__cell" colspan="1" rowspan="1"><div class="cell" style="text-align:center">星期四</div></th>
                                    <th class="el-table__cell" colspan="1" rowspan="1"><div class="cell" style="text-align:center">星期五</div></th>
                                    <th class="el-table__cell" colspan="1" rowspan="1"><div class="cell" style="text-align:center">星期六</div></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="el-table__row">
                                    <td class="el-table__cell" width="20px"><div class="cell">成本(CNY)</div> </td>
                                    <td class="el-table__cell" colspan="1" rowspan="1"><div class="cell" style="text-align:center"><el-input-number v-model="item.priceBatchSet" :controls="false" style="width:80px" :precision="2" :min="0" :max="100000" v-on:input="(value) => handlePriceInputChange(value, item.pricePlanId)"></el-input-number></div></td>
                                    <td class="el-table__cell" colspan="1" rowspan="1"><div class="cell" style="text-align:center"><el-input-number v-model="item.dailyPrices.Sunday" :controls="false" style="width:80px" :precision="2" :min="0" :max="100000"></el-input-number></div></td>
                                    <td class="el-table__cell" colspan="1" rowspan="1"><div class="cell" style="text-align:center"><el-input-number v-model="item.dailyPrices.Monday" :controls="false" style="width:80px" :precision="2" :min="0" :max="100000"></el-input-number></div></td>
                                    <td class="el-table__cell" colspan="1" rowspan="1"><div class="cell" style="text-align:center"><el-input-number v-model="item.dailyPrices.Tuesday" :controls="false" style="width:80px" :precision="2" :min="0" :max="100000"></el-input-number></div></td>
                                    <td class="el-table__cell" colspan="1" rowspan="1"><div class="cell" style="text-align:center"><el-input-number v-model="item.dailyPrices.Wednesday" :controls="false" style="width:80px" :precision="2" :min="0" :max="100000"></el-input-number></div></td>
                                    <td class="el-table__cell" colspan="1" rowspan="1"><div class="cell" style="text-align:center"><el-input-number v-model="item.dailyPrices.Thursday" :controls="false" style="width:80px" :precision="2" :min="0" :max="100000"></el-input-number></div></td>
                                    <td class="el-table__cell" colspan="1" rowspan="1"><div class="cell" style="text-align:center"><el-input-number v-model="item.dailyPrices.Friday" :controls="false" style="width:80px" :precision="2" :min="0" :max="100000"></el-input-number></div></td>
                                    <td class="el-table__cell" colspan="1" rowspan="1"><div class="cell" style="text-align:center"><el-input-number v-model="item.dailyPrices.Saturday" :controls="false" style="width:80px" :precision="2" :min="0" :max="100000"></el-input-number></div></td>
                                </tr>
                            </tbody>
                        </table>



                  

                    </div>

                </div>
   

        </el-form>
     
        <el-form-item>
            <div class="dialog-footer" style="text-align: center; width: 100%;">
                <el-button type="primary" v-on:click="save">保存 </el-button>
            </div>
        </el-form-item>
       
        </el-scrollbar>
    </el-main>

</el-container>
@section scripts {
    <script type="text/javascript">
        const app = Vue.createApp({
         setup() {
          
            const state = Vue.reactive({
               roomDropdown:@(Html.Raw(JsonConvert.SerializeObject(Model.RoomTypes, new JsonSerializerSettings { ContractResolver = new CamelCasePropertyNamesContractResolver() }))),
               formData: {
                        hotelId:``,
                        hotelName: '@Html.Raw(Model.HotelName)',
                        endDate: '@Html.Raw(DateTime.Now.AddDays(1).ToString("yyyy-MM-dd"))',
                        roomId: `@Html.Raw(Model.RoomTypeDefaultValue)`,  //切换房间
                        roomPricePlan: @(Html.Raw(JsonConvert.SerializeObject(Model.CruuentRoomPricePlan, new JsonSerializerSettings { ContractResolver = new CamelCasePropertyNamesContractResolver() }))),

                        rooms:[]

                },
                hotelRoomPricePlanAll: @(Html.Raw(JsonConvert.SerializeObject(Model.HotelRoomPricePlanAll, new JsonSerializerSettings { ContractResolver = new CamelCasePropertyNamesContractResolver() }))),
                
            });

            //选中加载房间类型
            const selectedLoadRoomValues = Vue.ref([`@Html.Raw(Model.RoomTypeDefaultValue)`])
            

            //批量设置库存
            const handleInputChange = (value) => Object.keys(currentRoom.value.inventory).forEach(key =>currentRoom.value.inventory[key] = value);

            //批量设置价格
            const handlePriceInputChange = (value,pricePlanId) =>{
                let currentPricePlan =currentRoom.value.prices.find(x=>x.pricePlanId==pricePlanId);
                 Object.keys(currentPricePlan.dailyPrices).forEach(key =>{
                     currentPricePlan.dailyPrices[key] = value
                 });
            };
                   
            
            const filteredRooms = Vue.computed(() => {
                const data = selectedLoadRoomValues.value.map(value => state.roomDropdown.find(room => room.value === value)).filter(room => room !== undefined);
                state.formData.roomId = selectedLoadRoomValues.value[0]??"";
                return data;
                })



                
         const checkAll = Vue.ref(false)
         const indeterminate = Vue.ref(true)
      

        const handleCheckAll = (val) => {
            if(val)
            {
                selectedLoadRoomValues.value=state.roomDropdown.map((_) => _.value)
            }
            else{
                selectedLoadRoomValues.value=[]
            }
        }
        // 处理节点选中状态变化
        const handleCheckChange = () => {
          const allChildren = state.roomDropdown
          const allIds = allChildren.map(item => item.value)
  
          // 检查是否所有子节点都被选中
          const allSelected = allIds.every(id => selectedLoadRoomValues.value.includes(id))
          checkAll.value = allSelected;

           if (selectedLoadRoomValues.value.length === 0) {
            indeterminate.value = false
          } else if (selectedLoadRoomValues.value.length === state.roomDropdown.length) {
            indeterminate.value = false
          } else {
            indeterminate.value = true
          }
        }
             //监听加载房间类型变化
            Vue.watch(() => selectedLoadRoomValues.value,(newVal, oldVal) => {
                 state.formData.rooms = state.formData.rooms.filter(obj =>newVal.includes(obj.roomId));
            }, { deep: true })


            // 监听选中值变化
            Vue.watch(() => state.formData.roomId,(newVal, oldVal) => {
              handleCheckChange();
              handleRoomChange(newVal)
            }, { deep: true })

            const FormDataRef = Vue.ref(null);
            const handleRoomChange=(value)=>{
                state.formData.roomId = value;
                state.formData.roomPricePlan = state.hotelRoomPricePlanAll.filter(item => item.roomId == value);
                initDefalutData();
            };

            const save = () => {
                axios.post('/Hotel/SaveLoadingInventoryAndPrices',  {...state.formData}).then(function (response) {
                    if (response.data.isSuccess) {
                        ElementPlus.ElMessage.success('保存成功');
                    } else {
                        ElementPlus.ElMessage.error('保存失败');
                    }
                })
            }


            const currentRoom = Vue.computed(() => {
                initDefalutData();
                return state.formData.rooms.find(x => x.roomId == state.formData.roomId);
            
            });


            // 初始化默认数据
            const initDefalutData = () => {
            
            state.formData.roomPricePlan = state.hotelRoomPricePlanAll.filter(item => item.roomId == state.formData.roomId);
                // 映射为新集合
               const prices = state.formData.roomPricePlan.map(item => ({ 
                                                  PriceBatchSet:null, 
                                                  pricePlanId: item.pricePlanId,
                                                  pricePlanName: item.pricePlanName, 
                                                  status: item.status,
                                                  statusName: item.statusName,
                                                  dailyPrices: {
                                                    Sunday: null,
                                                    Monday: null,
                                                    Tuesday: null,
                                                    Wednesday: null,
                                                    Thursday: null,
                                                    Friday: null,
                                                    Saturday: null
                                                  }
                                                }));



                let room={
                    roomId:state.formData.roomId,
                    inventoryBatchSet:null,
                    inventory: {
                                Sunday: null,
                                Monday: null,
                                Tuesday: null,
                                Wednesday: null,
                                Thursday: null,
                                Friday: null,
                                Saturday: null
                              },
                    prices: prices
                 };
                
            
                const roomIdSet = new Set(state.formData.rooms.map(item => item.roomId));
                 if(!roomIdSet.has(room.roomId)){
                  state.formData.rooms.push(room);
                 }
            };


            Vue.onMounted(() => {});
            return {
                state,save,
                FormDataRef,selectedLoadRoomValues,checkAll,filteredRooms,handleInputChange,handleCheckAll,indeterminate,handleRoomChange,currentRoom,handlePriceInputChange
            };
        }
        });
        app.use(ElementPlus, { locale: ElementPlusLocaleZhCn });
        app.mount('#app');
    </script>
}


