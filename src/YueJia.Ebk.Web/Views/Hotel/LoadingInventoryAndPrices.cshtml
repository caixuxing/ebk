@section scripts {
    <script type="text/javascript">
        const app = Vue.createApp({
         setup() {
            const state = Vue.reactive({
                roomDropdown: @(Html.Raw(Model.HotelRoomDataJson)),
               defaultProps: {
                        children: 'children',
                        label: 'label'
                    },
                formData: {
                        hotelName: '@Html.Raw(Model.HotelName)',
                        endDate: '@Html.Raw(DateTime.Now.AddDays(1).ToString("yyyy-MM-dd"))',
                        roomId: '',
                }

            });


            const selectedValues = Vue.ref([])
            const treeSelectRef = Vue.ref(null)
            const allChecked = Vue.ref(false)

            // 获取所有子节点的ID
            const getAllChildIds = (nodes) => {
              let ids = []
              nodes.forEach(node => {
                ids.push(node.value)
                if (node.children && node.children.length > 0) {
                  ids = ids.concat(getAllChildIds(node.children))
                }
              })
              return ids
            }

        // 处理全选复选框变化
        const handleAllCheckChange = (val) => {
          if (val) {
            // 获取所有子节点ID（排除全选节点本身）
            const allChildren = state.roomDropdown[0].children
            const allIds = getAllChildIds(allChildren)
            selectedValues.value = allIds
          } else {
            selectedValues.value = []
          }
        }

        // 处理节点选中状态变化
        const handleCheckChange = () => {
          const allChildren = state.roomDropdown[0].children
          const allIds = getAllChildIds(allChildren)
  
          // 检查是否所有子节点都被选中
          const allSelected = allIds.every(id => selectedValues.value.includes(id))
          allChecked.value = allSelected
        }

        // 监听选中值变化
        Vue.watch(selectedValues, () => {
          handleCheckChange()
        }, { deep: true })




            const FormDataRef = Vue.ref(null);
            return {
                state,
                FormDataRef,selectedValues,treeSelectRef,allChecked,getAllChildIds,handleAllCheckChange,handleCheckChange
            };
        }
        });
        app.use(ElementPlus, { locale: ElementPlusLocaleZhCn });
        app.mount('#app');
    </script>
}


