@section scripts {
    <script type="text/javascript">
        const app = Vue.createApp({
         setup() {
                    const inventoryBatchSet = Vue.ref(1);
            const state = Vue.reactive({
               roomDropdown:@(Html.Raw(JsonConvert.SerializeObject(Model.RoomTypes, new JsonSerializerSettings { ContractResolver = new CamelCasePropertyNamesContractResolver() }))),
               defaultProps: {
                        children: 'children',
                        label: 'label'
                    },
                formData: {
                        hotelName: '@Html.Raw(Model.HotelName)',
                        endDate: '@Html.Raw(DateTime.Now.AddDays(1).ToString("yyyy-MM-dd"))',
                        roomId: `@Html.Raw(Model.RoomTypeDefaultValue)`,
                        inventory:{
                            sunday:inventoryBatchSet.value,
                            monday:inventoryBatchSet.value,
                            tuesday:inventoryBatchSet.value,
                            wednesday:inventoryBatchSet.value,
                            thursday:inventoryBatchSet.value,
                            friday:inventoryBatchSet.value,
                            saturday:inventoryBatchSet.value,
                            
                        },
                      
                        roomPricePlan: @(Html.Raw(JsonConvert.SerializeObject(Model.CruuentRoomPricePlan, new JsonSerializerSettings { ContractResolver = new CamelCasePropertyNamesContractResolver() }))),
                },
                hotelRoomPricePlanAll: @(Html.Raw(JsonConvert.SerializeObject(Model.HotelRoomPricePlanAll, new JsonSerializerSettings { ContractResolver = new CamelCasePropertyNamesContractResolver() }))),
                
            });

        

            const selectedValues = Vue.ref([`@Html.Raw(Model.RoomTypeDefaultValue)`])
            

            const handleInputChange = (value) => {
                    Object.keys(state.formData.inventory).forEach(key =>
                        {
                            state.formData.inventory[key] = value;
                        });
                    };
            
            const filteredRooms = Vue.computed(() => {
                var data = state.roomDropdown.filter(room => selectedValues.value.includes(room.value));
                state.formData.roomId =data[0]?.value??"";
                return data;
                })



                
         const checkAll = Vue.ref(false)
         const indeterminate = Vue.ref(true)
      

        const handleCheckAll = (val) => {
            if(val)
            {
                selectedValues.value=state.roomDropdown.map((_) => _.value)
            }
            else{
                selectedValues.value=[]
            }
        }

              // 处理节点选中状态变化
        const handleCheckChange = () => {
          const allChildren = state.roomDropdown
          const allIds = allChildren.map(item => item.value)
  
          // 检查是否所有子节点都被选中
          const allSelected = allIds.every(id => selectedValues.value.includes(id))
          checkAll.value = allSelected;

           if (selectedValues.value.length === 0) {
            indeterminate.value = false
          } else if (selectedValues.value.length === state.roomDropdown.length) {
            indeterminate.value = false
          } else {
            indeterminate.value = true
          }
        }

        // 监听选中值变化
        Vue.watch(selectedValues, () => {
          handleCheckChange()
        }, { deep: true })

            const FormDataRef = Vue.ref(null);
            return {
                state,
                FormDataRef,selectedValues,checkAll,filteredRooms,inventoryBatchSet,handleInputChange,handleCheckAll,indeterminate
            };
        }
        });
        app.use(ElementPlus, { locale: ElementPlusLocaleZhCn });
        app.mount('#app');
    </script>
}


