@model YueJia.Ebk.Web.ViewModels.Hotel.ViewHotelVo

<div style="margin:15px 0px;" >

    <el-breadcrumb>
        <el-breadcrumb-item >
            <el-link :underline="false" href="/Hotel/HotelPublishList">数据列表</el-link>
        </el-breadcrumb-item>
        <el-breadcrumb-item>
            <el-link :underline="false" href="/Hotel/ViewHotel?id=@Model.Id">@Model.HotelName</el-link>
        </el-breadcrumb-item>
        <el-breadcrumb-item>
            <el-link :underline="false" href="/Hotel/RoomAndPricePlan?id=@Model.Id">房间与价格计划</el-link>
         </el-breadcrumb-item>
        <el-breadcrumb-item>

            <el-dropdown trigger="click">
                <span class="el-dropdown-link" style="cursor:pointer" >
                    库存与价格
                </span>
                <template #dropdown>
                    <div style="padding:10px;">
                        <ul>
                            <li style="padding: 5px 12px">
                                <el-link :underline="false" href="/Hotel/InventoryAndPrice/@Model.Id">库存和价格</el-link>
                            </li>
                            <li style="padding: 5px 12px">
                                <el-link :underline="false" href="/Hotel/InventoryCalendarMgr?userHotelId=@Model.Id">库存日历</el-link>
                            </li>
                            <li style="padding: 5px 12px">
                                <el-link :underline="false" href="/Hotel/PriceCalendarMgr?userHotelId=@Model.Id">价格日历</el-link>
                            </li>
                            <li style="padding: 5px 12px">
                                <el-link :underline="false" href="/Hotel/LoadingInventoryAndPrices/@Model.Id">加载库存与价格</el-link>
                            </li>
                            <li style="padding: 5px 12px">
                                <el-link :underline="false">批量编辑库存与价格</el-link>
                            </li>
                        </ul>
                    </div>
                </template>
            </el-dropdown>
         </el-breadcrumb-item>
    </el-breadcrumb>
</div>
