@model YueJia.Ebk.Web.ViewModels.Hotel.ViewHotelVo

@using YueJia.Ebk.Application.Contracts.SysApp
@using YueJia.Ebk.Domain.Shared.Enums
@using Newtonsoft.Json
@using Newtonsoft.Json.Serialization
@using YueJia.Ebk.Application.Contracts.OuterServiceApp
@inject ISysEnumApp enumApp
@inject IYueJiaSysServiceApp yueJiaSysServiceApp

@section head {
    <style scoped>
        .el-calendar-table .el-calendar-day {
            height: 90px !important;
        }

        body {
            overflow: auto;
        }
    </style>
}

<el-container style="height:100vh;overflow: hidden;">
    <el-main>

        @Html.Partial("~/Views/Hotel/UserHotelNavigationMgr.cshtml", (@ViewBag.mv as YueJia.Ebk.Web.ViewModels.Hotel.ViewHotelVo))

        <div style="height:50px;line-height:50px; position:relative ">
            <h1>价格日历</h1>
        </div>

        <el-divider content-position="left"></el-divider>

        <div style=" margin-bottom:10px; ">
            <el-text type="primary" size="large"> {{hotelModel.hotelNameEn  }} [{{hotelModel.hotelName}}]</el-text>
        </div>
        <el-form :inline="true" label-width="auto">
            <div>
                <el-form-item label="价格计划" style="margin-bottom:5px;">
                    <el-select placeholder="请选择" v-model="vmodel.userPlanId" filterable style="width:600px" v-on:change="onPlanChange">
                        <el-option v-for="ele in ebkOtaPricePlanList" :label="ele.pricePlanTitle" :value="''+ele.id"></el-option>
                    </el-select>
                </el-form-item>
            </div>
            <div>
                <el-form-item label="日期" style="margin-bottom:5px;">
                    <el-date-picker :clearable="false" v-model="vmodel.execData" type="month" format="YYYY-MM" value-format="YYYY-MM" v-on:change="onDateChange" />
                </el-form-item>
            </div>
        </el-form>

        <el-scrollbar>
        <el-calendar v-model="vmodel.calendarData"
                     style="pointer-events: none">
            <template #header="{ date }">
                <el-row style="width:100%;">
                    <el-col :span="24" style="text-align:right">
                        <el-button-group>
                            <el-button type="primary" style=" pointer-events: auto; " v-on:click="onRevoke">撤销</el-button>
                            <el-button type="primary" style=" pointer-events: auto; " v-on:click="onSave">保存</el-button>
                        </el-button-group>
                    </el-col>
                </el-row>
            </template>
            <template #date-cell="{ data }" style=" height: auto !important;">

                <div>
                    <el-text>{{data.day}}</el-text>
                </div>

                <div v-if=" getDailyPriceList(data.day).length>0  "    style="position:relative"  >
                    <div v-show=" getDailyPriceList(data.day)[0].price != getDailyPriceList(data.day)[0].initialPrice || getDailyPriceList(data.day)[0].initialStatusBool != getDailyPriceList(data.day)[0].statusBool   "
                         style="position:absolute;right:-5px;top:-20px; width:20px; height:20px; background:#2bb3f8">
                    </div>
                    <div>
                        <el-text>价格：</el-text>
                        <el-input-number style="pointer-events: auto;" 
                                         :controls="false"
                                        :precision="0"
                                         :value-on-clear="0"
                                         v-model="getDailyPriceList(data.day)[0].price" 
                                         :min="0" :max="100000"></el-input-number>
                    </div>
                    <div>
                        <el-text>状态：</el-text>
                        <el-checkbox v-model="getDailyPriceList(data.day)[0].statusBool" style=" pointer-events: auto;"></el-checkbox>
                    </div>

                </div>
                <div v-else>
                    <el-text>N/A</el-text>
                </div>

            </template>
        </el-calendar>
       </el-scrollbar>
    </el-main>
</el-container>
@section scripts {
    <script type="text/javascript">

        const app = Vue.createApp({
        setup() {
             const vmodel = Vue.reactive({
                    model : {
                        priceList:[],
                    },
                    execData:'@DateTime.Now.ToString("yyyy-MM")' ,
                    calendarData:'@DateTime.Now.ToString("yyyy-MM")' ,
                    userPlanId:'',

               });
                 const hotelModel =   @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.hotelModel, new System.Text.Json.JsonSerializerOptions() { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }))
                 const ebkOtaPricePlanList =  @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ebkOtaPricePlanList, new System.Text.Json.JsonSerializerOptions() { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));

                 Vue.onMounted(() => {

                     if(ebkOtaPricePlanList.length>0){
                         vmodel.userPlanId = ebkOtaPricePlanList[0].id;
                         loadData();
                     }
                 });

                const onPlanChange=()=>{
                        loadData();
                }
                /**
                 * onDateChange
                 */
                const onDateChange=()=>{
                        vmodel.calendarData = vmodel.execData
                        loadData();
                }

                /**
                 * 加载数据
                 */
                const loadData =()=>{
                    var dateYear = vmodel.execData.split('-')[0]
                    var dateMonth = vmodel.execData.split('-')[1]

                    axios.get(`/Hotel/GetPriceListResult?userPlanId=${vmodel.userPlanId}&dateYear=${dateYear}&dateMonth=${dateMonth}`, ).then(response => {
                        let {data,status}=response;
                        vmodel.model.priceList = data.data
                        console.log(   vmodel.model.priceList );
                    })
                };

                /**
                 * 撤销
                 */
                const onRevoke=()=>{
                    ElMessageBox.confirm('您确定撤销吗?', { confirmButtonText: '确定', cancelButtonText: '取消', type: 'warning', }).then(() => {
                        loadData();
                    })
                }

                 const onSave =()=>{

                    let { priceList } =  vmodel.model;
                    let reqData={
                        userPlanId: vmodel.userPlanId ,
                        priceList: JSON.parse(JSON.stringify(priceList))
                    }
                    axios['post'](`/Hotel/SavePriceCalendar`, reqData).then(res=>{
                        top.window.vueElMessage({ message: res.data. message , type:  res.data.isSuccess?'success':'info' })
                        if(res.data.isSuccess){
                               loadData();
                        }
                    })
                }

                const getDailyPriceList=(dateDay)=>{
                    return  vmodel.model.priceList.filter(vv=> vv.currentDateString ==dateDay );
                }


                return {
                   vmodel,
                   hotelModel,
                   onPlanChange,
                   onDateChange,
                   onSave,
                   onRevoke,
                   getDailyPriceList,
                   ebkOtaPricePlanList
                }
        }
        });
        app.use(ElementPlus,{ locale: ElementPlusLocaleZhCn });
        app.mount('#app');
    </script>
}


