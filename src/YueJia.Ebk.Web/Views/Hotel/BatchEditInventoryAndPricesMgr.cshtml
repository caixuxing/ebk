@section head {
    <style scoped>
        body {
            overflow: auto;
        }
    </style>
}
<el-container>
    <el-main>

        @Html.Partial("~/Views/Hotel/UserHotelNavigationMgr.cshtml", (@ViewBag.mv as YueJia.Ebk.Web.ViewModels.Hotel.ViewHotelVo))

        <div style="height:50px;line-height:50px;">
            <h1>批量编辑库存与价格</h1>
        </div>
        <el-divider content-position="left"></el-divider>

        <div style=" margin-bottom:10px; ">
            <el-checkbox v-model="vmodel.AState" v-on:change="AStateChange">
                 <el-text type="primary" size="large"> {{hotelModel.hotelName}}</el-text>
            </el-checkbox>
        </div>

        <el-card class="box-card" v-for="ele in vmodel.model.userRoomList" style=" margin-bottom:20px ">
            <template #header>
                <div class="card-header">
                    <div>
                        <el-checkbox v-model="ele.BState" v-on:change="BStateChange" >
                            <el-text>{{ele.startDateString}} 至 {{ele.endDateString}}</el-text>
                            <el-text style="margin-left:20px;"> {{ele.roomTypeName}}==>{{ele.bedTypeName}}</el-text>
                        </el-checkbox>
                       
                    </div>
                </div>
            </template>

            <div v-for="item in ele.pricePlans" >
                <el-checkbox v-model="item.CState" style="margin-left:30px;" v-on:change="CStateChange(item)">
                    <el-text  >{{item.pricePlanTitle}}</el-text>
                </el-checkbox>
            </div>
        </el-card>

        <el-form :inline="true" label-width="auto">
            <div>
                <el-form-item label="日期范围">
                    <el-date-picker is-range type="daterange" class="full-width-input"
                                    v-model="vmodel.dateRange"
                                    :clearable="false"
                                    format="YYYY-MM-DD" value-format="YYYY-MM-DD" start-placeholder="开始日期" end-placeholder="结束日期"></el-date-picker>
                </el-form-item>
            </div>
        </el-form>

        <el-tabs v-model="vmodel.activeName"
                 type="card"
                 v-show="userPlanIdList.length >0 "
                 class="demo-tabs">
            <el-tab-pane label="简易模式" name="simple">
                <el-divider content-position="left">房型维度</el-divider>
                <el-form :inline="true" label-width="auto" style="margin: 0 auto;width: 480px;">
                    <div>
                        <el-form-item label="库存">
                            <el-select v-model="vmodel.simpleModel.numExecType"
                                       v-show="vmodel.simpleModel.numFlag == true "
                                       style="width: 100px">
                                <el-option label="绝对值" value="1"></el-option>
                                <el-option label="增加" value="2" ></el-option>
                            </el-select>
                          
                            <el-input-number v-model="vmodel.simpleModel.num"
                                             v-show="vmodel.simpleModel.numFlag == true "
                                            :controls="false" style="width:80px;margin-left:15px;" :precision="0" :min="0" :max="20" ></el-input-number>

                            <el-button v-show="vmodel.simpleModel.numFlag == false " v-on:click="vmodel.simpleModel.numFlag = true">编辑</el-button>
                            <el-button v-show="vmodel.simpleModel.numFlag == true " v-on:click="vmodel.simpleModel.numFlag = false" type="danger">取消</el-button>
                        </el-form-item>
                    </div>
                    <div>
                        <el-form-item label="状态">
                            <el-checkbox v-show="vmodel.simpleModel.numStateFlag == true "
                                         v-model="vmodel.simpleModel.numState"> </el-checkbox>
                            <el-button v-show="vmodel.simpleModel.numStateFlag == false " v-on:click="vmodel.simpleModel.numStateFlag = true">编辑</el-button>
                            <el-button v-show="vmodel.simpleModel.numStateFlag == true " v-on:click="vmodel.simpleModel.numStateFlag = false" type="danger">取消</el-button>
                        </el-form-item>
                    </div>
               </el-form>

                <el-divider content-position="left">价格计划维度</el-divider>

                <el-form :inline="true" label-width="auto" style="margin: 0 auto;width: 480px;">
                    <div>
                        <el-form-item label="价格">
                            <el-select v-model="vmodel.simpleModel.priceExecType"
                                       v-show="vmodel.simpleModel.priceFlag == true "
                                       style="width: 100px">
                                <el-option label="绝对值" value="1"></el-option>
                                <el-option label="增加" value="2"></el-option>
                                <el-option label="百分比" value="3"></el-option>
                            </el-select>

                            <el-input-number v-model="vmodel.simpleModel.price"
                                             v-show="vmodel.simpleModel.priceFlag == true "
                                             :controls="false" style="width:80px;margin-left:15px;" :precision="0" :min="0" :max="20"></el-input-number>

                            <el-button v-show="vmodel.simpleModel.priceFlag == false " v-on:click="vmodel.simpleModel.priceFlag = true">编辑</el-button>
                            <el-button v-show="vmodel.simpleModel.priceFlag == true " v-on:click="vmodel.simpleModel.priceFlag = false" type="danger">取消</el-button>
                        </el-form-item>
                    </div>
                    <div>
                        <el-form-item label="状态">
                            <el-checkbox v-show="vmodel.simpleModel.priceStateFlag == true "
                                         v-model="vmodel.simpleModel.priceState"> </el-checkbox>
                            <el-button v-show="vmodel.simpleModel.priceStateFlag == false " v-on:click="vmodel.simpleModel.priceStateFlag = true">编辑</el-button>
                            <el-button v-show="vmodel.simpleModel.priceStateFlag == true " v-on:click="vmodel.simpleModel.priceStateFlag = false" type="danger">取消</el-button>
                        </el-form-item>
                    </div>
                </el-form>

                <div style="text-align:center" >
                    <el-button v-on:click="onSaveSimple">提交</el-button>
                </div>
            </el-tab-pane>

            <el-tab-pane label="高级模式" name="senior">

                <div v-for="ele in vmodel.model.userRoomList" >
                    <el-card style="width:250px;display: inline-block"  v-show =" ele.BState == true  "   >
                        <template #header>
                            <el-text > {{ele.roomTypeName}}==>{{ele.bedTypeName}}</el-text>
                        </template>

                        <el-form :inline="true" label-width="auto" label-position="top">
                            <div>
                                <el-form-item label="库存">
                                    <el-select v-model="ele.numExecType" style="width: 100px">
                                        <el-option label="绝对值" value="1"></el-option>
                                        <el-option label="增加" value="2"></el-option>
                                        <el-option label="无变化" value="0"></el-option>
                                    </el-select>

                                    <el-input-number v-model="ele.num" :controls="false" style="width:65px;margin-left:10px;" :precision="0" :min="0" :max="20"></el-input-number>
                                </el-form-item>
                            </div>
                            <div>
                                <el-form-item label="库存状态">
                                    <el-select style="width: 100px" v-model="ele.numState">
                                        <el-option label="启用" value="1"></el-option>
                                        <el-option label="停用" value="2"></el-option>
                                        <el-option label="无变化" value="0"></el-option>
                                    </el-select>
                                </el-form-item>
                            </div>
                        </el-form>

                    </el-card>
                  
                    <el-card v-for="item in ele.pricePlans" style="width:350px;display: inline-block;margin-left:10px" v-show=" item.CState == true  ">
                        <template #header>
                            <el-text><{{ (item.breakfastType=='1' ?'含早':'无早') }}>  ></el-text>
                            <el-text><提前{{ item.daysInAdvance }}天>  ></el-text>
                            <el-text><连住{{ item.continuousStayDays }}天>  ></el-text>
                            <el-text><{{ (item.isReservedRoom=='1' ?'保留房':'非保留房') }}>  ></el-text>
                        </template>
                        <el-form :inline="true" label-width="auto" label-position="top">
                            <div>
                                <el-form-item label="价格">
                                    <el-select style="width: 100px" v-model="item.priceExecType">
                                        <el-option label="绝对值" value="1"></el-option>
                                        <el-option label="增加" value="2"></el-option>
                                        <el-option label="无变化" value="0"></el-option>
                                    </el-select>

                                    <el-input-number :controls="false" v-model="item.price" style="width:65px;margin-left:10px;" :precision="0" :min="0" :max="20"></el-input-number>
                                </el-form-item>
                            </div>
                            <div>
                                <el-form-item label="价格状态">
                                    <el-select style="width: 100px" v-model="item.priceState">
                                        <el-option label="启用" value="1"></el-option>
                                        <el-option label="停用" value="2"></el-option>
                                        <el-option label="无变化" value="0"></el-option>
                                    </el-select>
                                </el-form-item>
                            </div>
                        </el-form>
                    </el-card>
                </div>

                <div style="text-align:center">
                    <el-button v-on:click="onSaveSenior">提交</el-button>
                </div>

            </el-tab-pane>
        </el-tabs>

    </el-main>
</el-container>
@section scripts {
    <script type="text/javascript">

        const app = Vue.createApp({
        setup() {
             const vmodel = Vue.reactive({
                    tempData:[],
                    model : {
                        userRoomList:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.userRoomList, new System.Text.Json.JsonSerializerOptions() { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }))
                    },
                    AState:false,
                    activeName:'simple',
                    dateRange:[ '@DateTime.Now.ToString("yyyy-MM-dd")', '@DateTime.Now.AddMonths(1).AddDays(-1).ToString("yyyy-MM-dd")'],
                    simpleModel:{
                         numFlag:false,
                         numExecType:'1',
                         num:0,
                         numStateFlag:false,
                         numState:false,


                         priceFlag:false,
                         priceExecType:'1',
                         price:0,
                         priceStateFlag:false,
                         priceState:false,

                    }
               });

               const userPlanIdList =Vue.computed(() =>{ 
                    var result = [];
                     vmodel.model.userRoomList.forEach(function(ele){
                       ele.pricePlans.forEach(function(item){
                           if(item.CState == true){
                            result.push(item.id);
                           }
                       })
                    });
                  return result
                }
               )



               const userRoomIdList =Vue.computed(() =>
               {
                    var result = [];
                     vmodel.model.userRoomList.forEach(function(ele){
                      if(ele.BState == true){
                            result.push(ele.id);
                       }
                    });
                  return result
                }
               )

               

                 const hotelModel =   @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.mv, new System.Text.Json.JsonSerializerOptions() { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }))

                 Vue.onMounted(() => {
                     console.log(vmodel.model.userRoomList);

                        
                 });

                 const AStateChange =()=>{
                    vmodel.model.userRoomList.forEach(function(ele){
                       ele.BState = vmodel.AState
                       ele.pricePlans.forEach(function(item){
                             item.CState = vmodel.AState
                       })
                    });
                 }

                 const BStateChange =()=>{
                    vmodel.model.userRoomList.forEach(function(ele){
                       ele.pricePlans.forEach(function(item){
                             item.CState = ele.BState
                       })
                    });
                 }

                 const CStateChange =(item)=>{
                    
                    vmodel.model.userRoomList.forEach(function(ele){
                        var planModel  = ele.pricePlans.find(vv=> vv.id == item.id);
                        if(planModel){
                          ele .BState = ele.pricePlans.filter(vv=> vv.CState == true).length>0;
                        }
                    });
                 }

                 /**
                  * 简易模式保存
                  */
                 const onSaveSimple=()=>{
                       let reqData =  JSON.parse(JSON.stringify(vmodel.simpleModel))
                       reqData.userRoomIdList =userRoomIdList.value;
                       reqData.userPlanIdList =  userPlanIdList.value;
                 
                         axios['post'](`/Hotel/BatchSaveInventoryAndPricesSimple`, reqData).then(res=>{
                             top.window.vueElMessage({ message: res.data. message , type:  res.data.isSuccess?'success':'info' })
                             if(res.data.isSuccess){
                                parent.layer.close(frameIndex); // 关闭当前弹框
                             }
                         })
                 }

                 /**
                  * 高级模式保存
                  */
                 const onSaveSenior=()=>{


                    var  userRoomList= [];
                      vmodel.model.userRoomList.forEach(function(ele){
                       if(ele.BState == true){
                             userRoomList.push( JSON.parse(JSON.stringify(ele))  );
                        }
                     });


                      var userPlanList = [];
                       vmodel.model.userRoomList.forEach(function(ele){
                         ele.pricePlans.forEach(function(item){
                             if(item.CState == true){
                              userPlanList.push(  JSON.parse(JSON.stringify(item)) );
                             }
                         })
                      });


      
                         

                       let reqData = {
                            userRoomList:userRoomList,
                            userPlanList:userPlanList,
                       }
                       console.log(reqData);

                         axios['post'](`/Hotel/BatchSaveInventoryAndPricesSenior`, reqData).then(res=>{
                             top.window.vueElMessage({ message: res.data. message , type:  res.data.isSuccess?'success':'info' })
                             if(res.data.isSuccess){
                                parent.layer.close(frameIndex); // 关闭当前弹框
                             }
                         })
                 }



                   
                return {
                    vmodel,
                    hotelModel,
                    AStateChange,
                    BStateChange,
                    CStateChange,
                    onSaveSimple,
                    onSaveSenior,
                    userPlanIdList,userRoomIdList
                }
        }
        });
        app.use(ElementPlus,{ locale: ElementPlusLocaleZhCn });
        app.mount('#app');
    </script>
}


