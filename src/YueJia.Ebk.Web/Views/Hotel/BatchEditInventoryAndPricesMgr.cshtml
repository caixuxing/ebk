@section head {
    <style scoped>
        body {
            overflow: auto;
        }
    </style>
}
<el-container style="height:100vh;overflow: hidden;">
    <el-main>

        @Html.Partial("~/Views/Hotel/UserHotelNavigationMgr.cshtml", (@ViewBag.mv as YueJia.Ebk.Web.ViewModels.Hotel.ViewHotelVo))

        <div style="height:50px;line-height:50px;">
            <h1>批量编辑库存与价格</h1>
        </div>

        <el-divider content-position="left"></el-divider>

        <div style=" margin-bottom:10px; ">
            <el-checkbox v-model="vmodel.AState" v-on:change="AStateChange">
                 <el-text type="primary" size="large"> 
                    @ViewBag.mv.HotelName
                 </el-text>
            </el-checkbox>
        </div>
        <el-scrollbar>
        <el-card class="box-card" v-for="ele in vmodel.model.userRoomList" style=" margin-bottom:5px ">
            <template #header>
                <div class="card-header">
                    <div>
                        <el-checkbox v-model="ele.BState" v-on:change="BStateChange" >
                            <el-text>{{ele.startDateString}} 至 {{ele.endDateString}}</el-text>
                            <el-text style="margin-left:20px;"> {{ele.hotelRoomTitle}}==>{{ele.bedTypeName}}</el-text>
                        </el-checkbox>
                       
                    </div>
                </div>
            </template>

            <div v-for="item in ele.planList">
                <el-checkbox v-model="item.CState" style="margin-left:30px;" v-on:change="CStateChange(item)">
                    <el-text  >{{item.pricePlanTitle}}</el-text>
                </el-checkbox>
            </div>
        </el-card>

        <el-form :inline="true" label-width="auto">
            <div>
                <el-form-item label="日期范围">
                    <el-date-picker is-range type="daterange" class="full-width-input"
                                    v-model="vmodel.dateRange"
                                    :clearable="false"
                                    format="YYYY-MM-DD" value-format="YYYY-MM-DD" start-placeholder="开始日期" end-placeholder="结束日期"></el-date-picker>
                </el-form-item>
            </div>
            <div>
                    <el-form-item label="星期范围">
                        <el-checkbox-group v-model="vmodel.weekIndexList">
                            <el-checkbox  :value="0"> 星期天</el-checkbox>
                            <el-checkbox :value="1"> 星期一</el-checkbox>
                            <el-checkbox :value="2"> 星期二</el-checkbox>
                            <el-checkbox :value="3"> 星期三</el-checkbox>
                            <el-checkbox :value="4"> 星期四</el-checkbox>
                            <el-checkbox :value="5"> 星期五</el-checkbox>
                            <el-checkbox :value="6"> 星期六</el-checkbox>
                        </el-checkbox-group>
                    </el-form-item>
            </div>
        </el-form>

        <el-tabs v-model="vmodel.activeName"
                 type="card"
                 v-show="vmodel.model.userRoomList.filter(vv=> vv.BState == true ).map(vv=>vv.id).length >0 "
                 class="demo-tabs">
            <el-tab-pane label="简易模式" name="simple">
                <el-divider content-position="left">房型维度</el-divider>
                    <el-form :inline="true" label-width="120px" style="margin: 0 auto;width: 680px;">
                    <div>
                        <el-form-item label="库存数量">
                            <el-select v-model="vmodel.simpleModel.inventoryNumExecType"
                                       v-show="vmodel.simpleModel.inventoryNumFlag == true "
                                       style="width: 100px">
                                <el-option label="绝对值" value="1"></el-option>
                                <el-option label="增加" value="2" ></el-option>
                            </el-select>
                          
                            <el-input-number v-model="vmodel.simpleModel.inventoryNum"
                                             v-show="vmodel.simpleModel.inventoryNumFlag == true "
                                            :value-on-clear="0"
                                            :controls="false" style="width:80px;margin-left:15px;" :precision="0" :min="0" :max="100" ></el-input-number>

                            <el-button v-show="vmodel.simpleModel.inventoryNumFlag == false " v-on:click="vmodel.simpleModel.inventoryNumFlag = true">编辑</el-button>
                            <el-button v-show="vmodel.simpleModel.inventoryNumFlag == true " v-on:click="vmodel.simpleModel.inventoryNumFlag = false" type="danger">取消</el-button>
                        </el-form-item>
                    </div>
                    <div>
                         <el-form-item label="库存状态">
                            <el-switch v-model="vmodel.simpleModel.inventoryState" active-text="开" inactive-text="关" v-show="vmodel.simpleModel.inventoryStateFlag == true " ></el-switch>
                            <el-button v-show="vmodel.simpleModel.inventoryStateFlag == false " v-on:click="vmodel.simpleModel.inventoryStateFlag = true">编辑</el-button>
                            <el-button v-show="vmodel.simpleModel.inventoryStateFlag == true " v-on:click="vmodel.simpleModel.inventoryStateFlag = false" type="danger">取消</el-button>
                        </el-form-item>
                    </div>
               </el-form>

                <el-divider content-position="left">价格计划维度</el-divider>

                    <el-form :inline="true" label-width="120px" style="margin: 0 auto;width: 680px;">
                    <div>
                         <el-form-item label="价格">
                            <el-select v-model="vmodel.simpleModel.planPriceExecType"
                                       v-show="vmodel.simpleModel.planPriceFlag == true "
                                       style="width: 100px;">
                                <el-option label="绝对值" value="1"></el-option>
                                <el-option label="增加" value="2"></el-option>
                                <el-option label="百分比" value="3"></el-option>
                            </el-select>
                          
                            <el-input-number v-model="vmodel.simpleModel.planPrice"
                                             v-show="vmodel.simpleModel.planPriceFlag == true "
                                              :value-on-clear="0"
                                                 :controls="false" style="width:80px;margin-left:15px;" :precision="0" :min="0" :max="100000"></el-input-number>

                            <el-button v-show="vmodel.simpleModel.planPriceFlag == false " v-on:click="vmodel.simpleModel.planPriceFlag = true">编辑</el-button>
                            <el-button v-show="vmodel.simpleModel.planPriceFlag == true " v-on:click="vmodel.simpleModel.planPriceFlag = false" type="danger">取消</el-button>
                        </el-form-item>
                    </div>
                    <div>
                        <el-form-item label="状态" style="margin-bottom:5px !important ;">
                            <el-switch v-show="vmodel.simpleModel.planPriceStateFlag == true "  v-model="vmodel.simpleModel.planPriceState" active-text="开" inactive-text="关" ></el-switch>
                            <el-button v-show="vmodel.simpleModel.planPriceStateFlag == false " v-on:click="vmodel.simpleModel.planPriceStateFlag = true">编辑</el-button>
                            <el-button v-show="vmodel.simpleModel.planPriceStateFlag == true " v-on:click="vmodel.simpleModel.planPriceStateFlag = false" type="danger">取消</el-button>
                        </el-form-item>
                    </div>
                </el-form>

                <div style="text-align:center" >
                    <el-button v-on:click="onSaveSimple">提交</el-button>
                </div>
            </el-tab-pane>

            <el-tab-pane label="高级模式" name="senior">

                <div v-for="ele in vmodel.model.userRoomList" >
                    <el-card style="width:250px;display: inline-block"  v-show =" ele.BState == true  "   >
                        <template #header>
                            <div style="white-space: nowrap;overflow: hidden;">
                                    <el-text> {{ele.hotelRoomTitle}}==>{{ele.bedTypeName}}</el-text>
                            </div>
                        </template>

                        <el-form :inline="true" label-width="auto" label-position="top">
                            <div>
                                <el-form-item label="库存">
                                    <el-select v-model="ele.inventoryNumExecType" style="width: 100px">
                                        <el-option label="绝对值" value="1"></el-option>
                                        <el-option label="增加" value="2"></el-option>
                                        <el-option label="无变化" value="*"></el-option>
                                    </el-select>

                                    <el-input-number v-model="ele.inventoryNum" 
                                                    :controls="false" 
                                                     :value-on-clear="0"
                                                     style="width:65px;margin-left:10px;" 
                                                    :precision="0" 
                                                    :min="0" :max="100"></el-input-number>
                                </el-form-item>
                            </div>
                            <div>
                                <el-form-item label="库存状态">
                                    <el-select style="width: 100px" v-model="ele.inventoryStateType">
                                        <el-option label="启用" value="1"></el-option>
                                        <el-option label="停用" value="2"></el-option>
                                        <el-option label="无变化" value="*"></el-option>
                                    </el-select>
                                </el-form-item>
                            </div>
                        </el-form>

                    </el-card>
                  
                    <el-card v-for="item in ele.planList" style="width:350px;display: inline-block;margin-left:10px" v-show=" item.CState == true  ">
                        <template #header>
                            <el-text><{{ (item.breakfastType=='1' ?'含早':'无早') }}>  ></el-text>
                            <el-text><提前{{ item.daysInAdvance }}天>  ></el-text>
                            <el-text><连住{{ item.continuousStayDays }}天>  ></el-text>
                            <el-text><{{ (item.isReservedRoom=='1' ?'保留房':'非保留房') }}>  ></el-text>
                        </template>
                        <el-form :inline="true" label-width="auto" label-position="top">
                            <div>
                                <el-form-item label="价格">
                                    <el-select style="width: 100px" v-model="item.planPriceExecType">
                                        <el-option label="绝对值" value="1"></el-option>
                                        <el-option label="增加" value="2"></el-option>
                                        <el-option label="无变化" value="*"></el-option>
                                    </el-select>

                                    <el-input-number :controls="false"
                                                     :value-on-clear="0"
                                                         :precision="0"
                                                         v-model="item.planPrice"
                                                     style="width:65px;margin-left:10px;"  :min="0" :max="100000"></el-input-number>
                                </el-form-item>
                            </div>
                            <div>
                                <el-form-item label="价格状态">
                                    <el-select style="width: 100px" v-model="item.planPriceStateType">
                                        <el-option label="启用" value="1"></el-option>
                                        <el-option label="停用" value="2"></el-option>
                                        <el-option label="无变化" value="*"></el-option>
                                    </el-select>
                                </el-form-item>
                            </div>
                        </el-form>
                    </el-card>
                </div>

                <div style="text-align:center">
                    <el-button v-on:click="onSaveSenior">提交</el-button>
                </div>

            </el-tab-pane>
        </el-tabs>
        </el-scrollbar>
    </el-main>
</el-container>
@section scripts {
    <script type="text/javascript">

        const app = Vue.createApp({
        setup() {
             const vmodel = Vue.reactive({
                    model : {
                        userRoomList:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.userRoomList, new System.Text.Json.JsonSerializerOptions() { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }))
                    },
                    AState:false,
                    activeName:'simple',
                    dateRange:[ '@DateTime.Now.ToString("yyyy-MM-dd")', '@DateTime.Now.AddMonths(1).AddDays(-1).ToString("yyyy-MM-dd")'],
                    weekIndexList:[0,1,2,3,4,5,6],
                    simpleModel:{

                         userHotelId:'@ViewBag.mv.Id',
                         inventoryNumFlag:false,
                         inventoryNumExecType:'1',
                         inventoryNum:0,
                         inventoryStateFlag:false,
                         inventoryState:false,


               
                         planPriceFlag:false,
                         planPriceExecType:'1',
                         planPrice:0,
                         planPriceStateFlag:false,
                         planPriceState:false,
                    },
               });

           


               /**
                * 房间Ids
                */
               const userRoomIdList =Vue.computed(() =>
               {
                  return  vmodel.model.userRoomList.filter(vv=> vv.BState == true ).map(vv=>vv.id);
               })

               /**
                * 价格计划Ids
                */
               const userPlanIdList =Vue.computed(() =>{ 
                    var result = [];
                       vmodel.model.userRoomList.forEach(function(ele){
                          result = result.concat(ele.planList);
                      });
                    return result.filter(vv=> vv.CState == true ).map(vv=>vv.id);
                })



                 Vue.onMounted(() => {
                     console.log(vmodel.model.userRoomList);
                     console.log(vmodel.weekIndexList);
                     console.log('@ViewBag.mv.Id');
                 });

                 const AStateChange =()=>{
                    vmodel.model.userRoomList.forEach(function(ele){
                       ele.BState = vmodel.AState
                       ele.planList.forEach(function(item){
                             item.CState = vmodel.AState
                       })
                    });
                 }

                 const BStateChange =()=>{
                    vmodel.model.userRoomList.forEach(function(ele){
                       ele.planList.forEach(function(item){
                             item.CState = ele.BState
                       })
                    });
                 }

                 const CStateChange =(item)=>{
                    vmodel.model.userRoomList.forEach(function(ele){
                        var planModel  = ele.planList.find(vv=> vv.id == item.id);
                        if(planModel){
                          ele .BState = ele.planList.filter(vv=> vv.CState == true).length>0;
                        }
                    });
                 }

                 /**
                  * 简易模式保存
                  */
                 const onSaveSimple=()=>{

                       let reqData =  JSON.parse(JSON.stringify(vmodel.simpleModel))
                       reqData.userRoomIdList =userRoomIdList.value;
                       reqData.userPlanIdList =  userPlanIdList.value;
                       reqData.startDate =vmodel.dateRange[0];
                       reqData.endDate=vmodel.dateRange[1];
                       reqData.weekIndexList = vmodel.weekIndexList;

                       axios['post'](`/Hotel/BatchSaveInventoryAndPricesSimple`, reqData).then(res=>{
                           top.window.vueElMessage({ message: res.data. message , type:  res.data.isSuccess?'success':'info' })
                           if(res.data.isSuccess){
                              parent.layer.close(frameIndex); // 关闭当前弹框
                           }
                       })
                 }

                 /**
                  * 高级模式保存
                  */
                 const onSaveSenior=()=>{


                    var  userRoomList= [];
                      vmodel.model.userRoomList.forEach(function(ele){
                       if(ele.BState == true){
                             userRoomList.push( JSON.parse(JSON.stringify(ele))  );
                        }
                     });


                      var userPlanList = [];
                       vmodel.model.userRoomList.forEach(function(ele){
                         ele.planList.forEach(function(item){
                             if(item.CState == true){
                              userPlanList.push(  JSON.parse(JSON.stringify(item)) );
                             }
                         })
                      });


      
                         

                       let reqData = {
                            userHotelId:'@ViewBag.mv.Id',
                            userRoomList:userRoomList,
                            userPlanList:userPlanList,
                            startDate :vmodel.dateRange[0],
                            endDate:vmodel.dateRange[1],
                            weekIndexList : vmodel.weekIndexList,
                       }
                       console.log(reqData);

                         axios['post'](`/Hotel/BatchSaveInventoryAndPricesSenior`, reqData).then(res=>{
                             top.window.vueElMessage({ message: res.data. message , type:  res.data.isSuccess?'success':'info' })
                             if(res.data.isSuccess){
                                parent.layer.close(frameIndex); // 关闭当前弹框
                             }
                         })
                 }



                   
                return {
                    vmodel,
                    AStateChange,
                    BStateChange,
                    CStateChange,
                    onSaveSimple,
                    onSaveSenior,
                    userPlanIdList
                }
        }
        });
        app.use(ElementPlus,{ locale: ElementPlusLocaleZhCn });
        app.mount('#app');
    </script>
}


