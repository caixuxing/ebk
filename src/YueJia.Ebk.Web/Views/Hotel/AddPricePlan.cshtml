@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<el-container style="height:100vh;overflow: hidden;">
    <el-main>
        <el-form :model="state.formData" label-width="auto" >
            <el-alert type="primary" show-icon :closable="false">
                <p>[我的酒店] / <el-link type="primary" v-on:click="openViewHotel">1111111111111111")</el-link> / <el-link type="primary" v-on:click="openRoomAndPricePlan">房间与价格计划</el-link> / 库存与价格 / 促销</p>
            </el-alert>
            <el-form-item style="margin-top:30px">
                <h1>新增价格计划</h1>
            </el-form-item>
            <el-divider content-position="left">房间信息</el-divider>
            <el-form-item label="酒店编码">
                <el-text class="mx-1">{{state.formData.hotelCode}}</el-text>
            </el-form-item>

            <el-form-item label="酒店名称">
              
                       <el-text class="mx-1">{{state.formData.hotelName}}</el-text>
            </el-form-item>

            <el-form-item label="房型名称">
                <el-text class="mx-1">{{state.formData.roomTypeName}}</el-text>
            </el-form-item>

            <el-form-item label="床型">
                <el-input v-model="state.formData.roomNum"></el-input>
                 <el-text class="mx-1">{{state.formData.bedTypeName}}</el-text>
            </el-form-item>

       
            <el-divider content-position="left">价格计划设置</el-divider>

            <el-form-item label="早餐类型">
                <el-select v-model="state.formData.roomTypeId" placeholder="请选择房间类型">
                    <el-option label="标准间" value="1"></el-option>
                    <el-option label="豪华间" value="2"></el-option>
                    <el-option label="总统间" value="3"></el-option>
                </el-select>
            </el-form-item>

            <el-form-item label="提前天数">
                <el-input v-model="state.formData.price"></el-input>
            </el-form-item>

            <el-form-item label="连住天数">
                <el-input v-model="state.formData.discount"></el-input>
            </el-form-item>

            <el-form-item label="保留房">
            <el-switch v-model="state.formData.status" inline-prompt active-text="是" inactive-text="否"/>
            </el-form-item>

            <el-form-item label="状态">
                 <el-switch v-model="state.formData.status" inline-prompt active-text="是" inactive-text="否"/>
            </el-form-item>
            </el-form>



    </el-main>
</el-container>
@section scripts {
    <script type="text/javascript">
        const app = Vue.createApp({
        setup() {

                const state = Vue.reactive({
                    formData: {
                        roomTypeId: '',
                        roomTypeName: '',
                    }
                });


                return {
                    state
                }
        }
        });
        app.use(ElementPlus);
        app.mount('#app');
    </script>
}


