@model YueJia.Ebk.Web.ViewModels.Hotel.ViewHotelVo
<el-container style="height:100vh;overflow: hidden;">
    <el-main>

        @Html.Partial("~/Views/Hotel/UserHotelNavigationMgr.cshtml", Model)

        <div style="height:50px;line-height:50px;" >
            <h1>酒店</h1>
        </div>
        <el-divider content-position="left"></el-divider>
        <el-form label-width="auto" style="width:800px; margin:0px auto;" v-on:submit.native.prevent>

            <el-form-item label="酒店编码" >
                <el-text>{{vmodel.hotelCode}}</el-text>
            </el-form-item>
            <el-form-item label="酒店名称">
                <el-text>{{vmodel.hotelName}}（{{vmodel.hotelNameEn}}）</el-text>
            </el-form-item>
            <el-form-item label="酒店地址" label-width="auto" >
                <el-text>{{vmodel.addressEn}}</el-text>
            </el-form-item>
            <el-form-item label="联系电话" label-width="auto" >
                <el-text>{{vmodel.telPhone}}</el-text>
            </el-form-item>
            <el-form-item label="最低价" label-width="auto"  >
                <el-input-number v-model="vmodel.lowestPrice"
                                 :controls="false" 
                                 style="width:100px" 
                                 :value-on-clear="0"
                                 :min="0"
                                 :precision="2"
                                 :max="10000000" 
                                ></el-input-number>
            </el-form-item>
            <el-form-item label="销售状态" label-width="auto">
                <el-radio-group v-model="vmodel.status">
                    @foreach (var ele in ViewBag.HotelSaleTypeList)
                    {
                        <el-radio :label="@ele.Value">@ele.Describe</el-radio>
                    }
                </el-radio-group>
      </el-form-item>
    </el-form>
        <el-form-item>
            <div class="dialog-footer" style="text-align: center; width: 100%;">
                <el-button type="primary" v-on:click="save">保存 </el-button>
            </div>
        </el-form-item>
    </el-main>
</el-container>
@section scripts {
    <script type="text/javascript">
        const app = Vue.createApp({
        setup() {

              const vmodel =  Vue.reactive(
                     @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model, new System.Text.Json.JsonSerializerOptions() { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }))
                 );

                /**
                 * 保存
                 */
                 const save =  () => {
                        let reqData = { ...vmodel };
                        axios['put'](`/Hotel/${vmodel.id}/UpdatePublishHotel`, reqData).then(res=>{
                            top.window.vueElMessage({ message: res.data. message , type:  res.data.isSuccess?'success':'info' })
                       })
                 };

                return {
                     vmodel
                    ,save
                }
        }
        });
        app.use(ElementPlus);
        app.mount('#app');
    </script>
}


