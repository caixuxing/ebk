@model YueJia.Ebk.Web.ViewModels.Hotel.ViewHotelVo
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section head {
    <title>查看酒店</title>
    <style scoped>
        .el-input-number .el-input__inner{

        text-align:left !important;
        }
    </style>
}
<el-container style="height:100vh;overflow: hidden;">
    <el-main>

        @Html.Partial("~/Views/Hotel/UserHotelNavigationMgr.cshtml", Model)

        <div style="height:50px;line-height:50px;" >
            <h1>酒店</h1>
        </div>
        <el-divider content-position="left"></el-divider>
        <el-form  label-width="auto" style="width:800px; margin:0px auto;"  >


            @*    <el-alert type="primary" show-icon :closable="false" >
                <p>[我的酒店] / @Html.Raw($"{Model.HotelName}({Model.HotelNameEn})") / <el-link type="primary" >房间与价格计划</el-link> / 库存与价格 / 促销</p>
            </el-alert> *@
            <el-form-item label="酒店编码" >
                <el-text class="mx-1">{{model.hotelCode}}</el-text>
            </el-form-item>
            <el-form-item label="酒店名称">
                <el-text class="mx-1">{{model.hotelName}}（{{model.hotelNameEn}}）</el-text>
            </el-form-item>
            <el-form-item label="酒店地址" label-width="auto" >
                <el-text class="mx-1">{{model.addressEn}}</el-text>
            </el-form-item>
            <el-form-item label="联系电话" label-width="auto" >
                <el-text class="mx-1">{{model.telPhone}}</el-text>
            </el-form-item>
            <el-form-item label="最低价" label-width="auto"  >
                <el-input-number v-model="model.lowestPrice" :controls="false" style="width:100px" :min="0" :max="10000000" v-on:change="onLowestPriceChange"></el-input-number>
            </el-form-item>
            <el-form-item label="销售状态" label-width="auto">
                <el-radio-group v-model="model.status">
                    @foreach (var ele in ViewBag.HotelSaleTypeList)
                    {
                        <el-radio :label="@ele.Value">@ele.Describe</el-radio>
                    }
                </el-radio-group>
      </el-form-item>
    </el-form>
        <el-form-item>
            <div class="dialog-footer" style="text-align: center; width: 100%;">
                <el-button type="primary" v-on:click="save">保存 </el-button>
            </div>
        </el-form-item>
    </el-main>
</el-container>
@section scripts {
    <script type="text/javascript">

      

        const app = Vue.createApp({
        setup() {

              const model =  Vue.reactive(
                     @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model, new System.Text.Json.JsonSerializerOptions() { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }))
                 );

                 console.log('**********');
                 console.log(model);

               const onLowestPriceChange = (val) => {
                      if (val === null || val === undefined ) {
                        model.lowestPrice = 0; // 自动重置为默认值
                      }
                };

                /**
                 * 保存
                 */
             const save =  () => {
                    let reqData = { ...model };
                    axios['put'](`/Hotel/${model.id}/UpdatePublishHotel`, reqData).then(res=>{
                             top.window.vueElMessage({ message: res.data. message , type:  res.data.isSuccess?'success':'info' })
                   })
             };

                return {
                     model
                    ,save
                    ,onLowestPriceChange
                }
        }
        });
        app.use(ElementPlus);
        app.mount('#app');
    </script>
}


