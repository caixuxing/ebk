@using YueJia.Ebk.Application.Contracts.SysApp
@using YueJia.Ebk.Domain.Shared.Enums
@using Newtonsoft.Json
@using Newtonsoft.Json.Serialization
@using YueJia.Ebk.Application.Contracts.OuterServiceApp
@model  YueJia.Ebk.Web.ViewModels.Hotel.AddHotelRoomVo
@inject ISysEnumApp enumApp
@inject IYueJiaSysServiceApp yueJiaSysServiceApp

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section head {
    <title>添加酒店房间</title>

    <style scoped>
		.el-input-number .el-input__inner{
        
        text-align:left !important;
        }
        </style>
}
<el-container style="height:100vh;overflow: hidden;">
    <el-main>
        <el-form :model="state.formData" label-width="auto" >
             <el-alert type="primary" show-icon :closable="false" >
             <p>[feiheng] / Pimalai Resort And Spa(皮马莱度假村和水疗中心) / 房间与价格计划 / 库存与价格 / 促销</p>
             </el-alert>
            <el-divider content-position="left">房间信息</el-divider>
            <el-form-item label="酒店名称">
                <el-input v-model="state.formData.hotelCode" autocomplete="off" clearable placeholder="酒店编码" style="width:50%"></el-input>
                 <el-text class="mx-1">{{state.formData.hotelName}}</el-text>

            </el-form-item>
            <el-form-item label="房型" required prop="roomType" >
                  <el-select v-model="state.formData.roomType" placeholder="请选择房型"  filterable   style="width:50%"> 
                       <el-option v-for="option in state.roomTypeData" :key="option.value" :label="option.label" :value="option.value"  ></el-option>
                    </el-select>
            </el-form-item>
            <el-form-item label="床型"  required prop="bedType">
                   <el-select v-model="state.formData.bedType" placeholder="请选择床型"  filterable  style="width:50%"> 
                       <el-option v-for="option in state.bedTypeData" :key="option.value" :label="`${option.describe} ${option.name}`" :value="option.value"  ></el-option>
                    </el-select>
            </el-form-item>
            <el-form-item label="人数上限">
               <el-input-number v-model="state.formData.maximumNumberOfPeople" controls-position="right" style="width:50%" placeholder="人数上限"></el-input-number>
            </el-form-item>
            <el-form-item label="成人上限" label-width="auto">
               <el-input-number v-model="state.formData.adultLimit" controls-position="right" style="width:50%" placeholder="成人上限"></el-input-number>
            </el-form-item>
            <el-form-item label="儿童上限" label-width="auto">
               <el-input-number v-model="state.formData.childLimit" controls-position="right" style="width:50%" placeholder="儿童上限"></el-input-number>
            </el-form-item>
          
         <el-divider content-position="left" style="margin-top:50px">库存设置</el-divider>
              <el-form-item label="日期范围" label-width="auto">
              <el-date-picker v-model="state.stock.dateRange" type="daterange" start-placeholder="开始日期" end-placeholder="结束日期"
                      :default-value="[new Date(2025, 05, 26), new Date(2025, 05, 26)]" style="width:200px"></el-date-picker>
            </el-form-item>
              <el-form-item label="房间库存" label-width="auto">
                  <div class="el-table--fit el-table--border el-table--scrollable-y el-table--enable-row-hover el-table el-table--layout-fixed is-scrolling-none" data-prefix="el" style="width: 100%; height: 100px;">
                      <div class="el-table__inner-wrapper">
                          <div class="el-table__header-wrapper">
                          <table class="el-table__header" border="0" cellpadding="0" cellspacing="0" style="width: 100%;">
                              <thead>
                                <tr>
                                      <th class="el-table_1_column_1 is-leaf el-table__cell" colspan="1" rowspan="1"><div class="cell">星期一</div></th>
                                      <th class="el-table_1_column_2 is-leaf el-table__cell" colspan="1" rowspan="1"><div class="cell">星期二</div></th>
                                      <th class="el-table_1_column_3 is-leaf el-table__cell" colspan="1" rowspan="1"><div class="cell">星期三</div></th>
                                      <th class="el-table_1_column_4 is-leaf el-table__cell" colspan="1" rowspan="1"><div class="cell">星期四</div></th>
                                      <th class="el-table_1_column_5 is-leaf el-table__cell" colspan="1" rowspan="1"><div class="cell">星期五</div></th>
                                      <th class="el-table_1_column_6 is-leaf el-table__cell" colspan="1" rowspan="1"><div class="cell">星期六</div></th>
                                      <th class="el-table_1_column_7 is-leaf el-table__cell" colspan="1" rowspan="1"><div class="cell">星期日</div></th>
                                  </tr>
                                </thead>
                                <tbody>
                                    <tr class="el-table__row">
                                        <td class="el-table__cell" colspan="1" rowspan="1">
                                            <div class="cell">
                                              <el-input-number v-model="state.stock.stock.one" controls-position="right" style="width:100%" ></el-input-number>
                                            </div>
                                        </td>
                                        <td class="el-table__cell" colspan="1" rowspan="1"><div class="cell"><el-input-number v-model="state.stock.stock.two" controls-position="right" style="width:100%" ></el-input-number></div></td>
                                        <td class="el-table__cell" colspan="1" rowspan="1"><div class="cell"><el-input-number v-model="state.stock.stock.three" controls-position="right" style="width:100%"></el-input-number></div></td>
                                        <td class="el-table__cell" colspan="1" rowspan="1"><div class="cell"><el-input-number v-model="state.stock.stock.four" controls-position="right" style="width:100%"></el-input-number></div></td>
                                        <td class="el-table__cell" colspan="1" rowspan="1"><div class="cell"><el-input-number v-model="state.stock.stock.five" controls-position="right" style="width:100%"></el-input-number></div></td>
                                        <td class="el-table__cell" colspan="1" rowspan="1"><div class="cell"><el-input-number v-model="state.stock.stock.six" controls-position="right" style="width:100%"></el-input-number></div></td>
                                        <td class="el-table__cell" colspan="1" rowspan="1"><div class="cell"><el-input-number v-model="state.stock.stock.seven" controls-position="right" style="width:100%"></el-input-number></div></td>
                                    </tr>
                                    </tbody>
                                  </table>
                               </div>
                           </div>
                   </div>
            </el-form-item>
            </el-form>


                    <el-form-item>
      <div class="dialog-footer" style="text-align: center; width: 100%;">
         <el-button v-on:click="cancel" >返回 </el-button>
        <el-button type="primary" v-on:click="save" >保存 </el-button>
      </div>
            </el-form-item>
            
            



          
    </el-main>
</el-container>
@section scripts {
    <script type="text/javascript">
        const app = Vue.createApp({
        setup() {
                const state = Vue.reactive({
                    bedTypeData:@(Html.Raw(JsonConvert.SerializeObject(enumApp.GetEnumDataList(nameof(BedTypeEnum)), new JsonSerializerSettings { ContractResolver = new CamelCasePropertyNamesContractResolver() }))),
                    roomTypeData:@(Html.Raw(JsonConvert.SerializeObject( await yueJiaSysServiceApp.GetDropDownRoomTypeByHotelCodeAsync(Model.HotelCode), new JsonSerializerSettings { ContractResolver = new CamelCasePropertyNamesContractResolver() }))),
                    formData: {
                       hotelCode: `@Html.Raw(Model.HotelCode)`,
                       hotelName: `@Html.Raw(Model.HotelName)`,
                       roomType:`@Html.Raw(Model.RoomType)`,
                       bedType:`@Html.Raw(Model.BedType)`,
                       maximumNumberOfPeople:@Html.Raw(Model.MaximumNumberOfPeople),
                       adultLimit:@Html.Raw(Model.AdultLimit),
                       childLimit:@Html.Raw(Model.ChildLimit),
                    },
                    stock:{
                        dateRange:[`@(Html.Raw(Model.Stock.StartDate.ToString("yyyy-MM-dd")))`,`@(Html.Raw(Model.Stock.EndDate.ToString("yyyy-MM-dd")))`],
                        stock:{
                            one:@Html.Raw(Model.Stock.Stock.SingleOrDefault(x=>x.Key==WeekTypeMnum.Monday).Value),
                            two:@Html.Raw(Model.Stock.Stock.SingleOrDefault(x=>x.Key==WeekTypeMnum.Tuesday).Value),
                            three:@Html.Raw(Model.Stock.Stock.SingleOrDefault(x=>x.Key==WeekTypeMnum.Wednesday).Value),
                            four:@Html.Raw(Model.Stock.Stock.SingleOrDefault(x=>x.Key==WeekTypeMnum.Thursday).Value),
                            five:@Html.Raw(Model.Stock.Stock.SingleOrDefault(x=>x.Key==WeekTypeMnum.Friday).Value),
                            six:@Html.Raw(Model.Stock.Stock.SingleOrDefault(x=>x.Key==WeekTypeMnum.Saturday).Value),
                            seven:@Html.Raw(Model.Stock.Stock.SingleOrDefault(x=>x.Key==WeekTypeMnum.Sunday).Value),
                        }
                    }
                });
                 const save=()=>{
                   window.parent.mainFrame(`/Hotel/HotelPublishList`,`我的酒店`,`page3-1`);
                 };
                const cancel=()=>{
                   window.parent.mainFrame(`/Hotel/HotelPublishList`,`我的酒店`,`page3-1`);
                 };
                return {state,save,cancel }
        }
        });
        app.use(ElementPlus);
        app.mount('#app');
    </script>
}


