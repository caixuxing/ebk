@using YueJia.Ebk.Application.Contracts.SysApp
@using YueJia.Ebk.Domain.Shared.Enums
@using Newtonsoft.Json
@using Newtonsoft.Json.Serialization
@using YueJia.Ebk.Application.Contracts.OuterServiceApp
@model YueJia.Ebk.Application.Contracts.HotelApp.Commands.CreateHotelRoomCmd
@inject ISysEnumApp enumApp
@inject IYueJiaSysServiceApp yueJiaSysServiceApp


@section head {
    <style scoped>
        .my-label {
            text-align: center !important;
        }
    </style>
}

<el-container style="height:100vh;">
    <el-main>
        <h1 :underline="false">@ViewBag.HotelName</h1>

        <el-divider content-position="left">房间信息</el-divider>

        <el-form :inline="true"   label-width="auto"  >
            <div>
                <el-form-item label="房型" required >
                    <el-select v-model="model.roomType" placeholder="请选择房型" filterable  style="width:600px"  v-on:change="onRoomChange" >
                        <el-option v-for="ele in otaRoomList" :label="roomDescribe(ele)" :value="''+ele.roomcode"   ></el-option>
                    </el-select>
                </el-form-item>
                @* ele.roomnameen *@
            </div>
            <div>
                <el-form-item label="床型" >
                    <el-select disabled v-model="model.bedType" placeholder="" filterable style="width:250px">
                        @foreach (var ele in enumApp.GetEnumDataList(nameof(BedTypeEnum)))
                        {
                            <el-option label='@ele.Describe &nbsp @ele.Name' :value="@ele.Value"></el-option>
                             
                        }
                    </el-select>
                </el-form-item>
            </div>
            
            <div>
               <el-form-item label="人数上限">
                    <el-select v-model="model.maximumNumberOfPeople" placeholder="人数上限" filterable style="width:250px" v-on:change=" model.adultLimit=model.maximumNumberOfPeople;model.childLimit=0;  ">
                        <el-option v-for="ele in 5" :label="ele" :value="ele"></el-option>
                    </el-select>

                </el-form-item>
                <el-form-item label="成人上限" label-width="auto">

                    <el-select v-model="model.adultLimit" placeholder="成人上限" filterable style="width:250px"  >
                        <el-option v-for="ele in (model.maximumNumberOfPeople -model.childLimit ) " :label="ele" :value="ele"></el-option>
                    </el-select>
                </el-form-item>

                <el-form-item label="儿童上限" label-width="auto">
                    <el-select v-model="model.childLimit" placeholder="儿童上限" filterable style="width:250px">
                        <el-option :label="0" :value="0"></el-option>
                        <el-option v-for="ele in  (model.maximumNumberOfPeople -model.adultLimit )" :label="ele" :value="ele"></el-option>
                    </el-select>
                </el-form-item> 
            </div>
        </el-form>

        <el-divider content-position="left">库存设置</el-divider>

        <el-form :inline="true" label-width="auto">
            <div>
                <el-form-item label="日期范围"   >
                    <el-date-picker is-range type="daterange" class="full-width-input"
                                    v-model="model.dateRange"
                                    format="YYYY-MM-DD" value-format="YYYY-MM-DD" start-placeholder="开始日期" end-placeholder="结束日期"
                                    clearable></el-date-picker>
        
                </el-form-item>
            </div>
            <div>
                <el-form-item label="房间库存" >

                    <el-descriptions  direction="vertical" :column="7" border>
                        <el-descriptions-item label="星期天" label-class-name="my-label">
                            <el-input-number v-model="model.sunday" :controls="false" style="width:80px" :precision="0" :min="0" :max="20"></el-input-number>
                        </el-descriptions-item>
                        <el-descriptions-item label="星期一" label-class-name="my-label">
                            <el-input-number v-model="model.monday" :controls="false" style="width:80px" :precision="0" :min="0" :max="20"></el-input-number>
                        </el-descriptions-item>
                        <el-descriptions-item label="星期二" label-class-name="my-label">
                            <el-input-number v-model="model.tuesday" :controls="false" style="width:80px" :precision="0" :min="0" :max="20"></el-input-number>
                        </el-descriptions-item>
                        <el-descriptions-item label="星期三" label-class-name="my-label">
                            <el-input-number v-model="model.wednesday" :controls="false" style="width:80px" :precision="0" :min="0" :max="20"></el-input-number>
                        </el-descriptions-item>
                        <el-descriptions-item label="星期四" label-class-name="my-label">
                            <el-input-number v-model="model.thursday" :controls="false" style="width:80px" :precision="0" :min="0" :max="20"></el-input-number>
                        </el-descriptions-item>
                        <el-descriptions-item label="星期五" label-class-name="my-label">
                            <el-input-number v-model="model.friday" :controls="false" style="width:80px" :precision="0" :min="0" :max="20"></el-input-number>
                        </el-descriptions-item>
                        <el-descriptions-item label="星期六" label-class-name="my-label">
                            <el-input-number v-model="model.saturday" :controls="false" style="width:80px" :precision="0" :min="0" :max="20"></el-input-number>
                        </el-descriptions-item>
            
                    </el-descriptions>

                </el-form-item>
            </div>
        </el-form>
    </el-main>
    <el-footer>
        <div style="text-align: center;">
            <el-button type="primary" v-on:click="onSave">保存 </el-button>
        </div>
    </el-footer>
</el-container>
@section scripts {
    <script type="text/javascript">
        var frameIndex = parent.layer.getFrameIndex(window.name);

        const app = Vue.createApp({
        setup() {
                const maxAdultNumber=Vue.ref(5);
                const maxChildrenNumber=Vue.ref(0);
                const model =  Vue.reactive(
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model, new System.Text.Json.JsonSerializerOptions() { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }))
                );
                const otaRoomList = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(await yueJiaSysServiceApp.GetOTARoomAsync(Model.HotelCode), new System.Text.Json.JsonSerializerOptions() { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));
               
                Vue.onMounted(() => {
                     model.dateRange =[`@(Html.Raw(Model.StartDate.ToString("yyyy-MM-dd")))`,`@(Html.Raw(Model.EndDate.ToString("yyyy-MM-dd")))`];
                     console.log(model);
                 });


                 /*
                 * 房型描述
                 */
                 const roomDescribe =(ele)=>{
                    return ele.roomname +' '+ ele.roomnameen;
                 }

                 /**
                  * 房型改变事件
                  */
                 const onRoomChange=()=>{

                     var roomObj =  otaRoomList.find(vv=>vv.roomcode == model.roomType);
                       model.bedType =roomObj.bedtype;
                       model.hotelRoomTitle =  `${roomObj.roomname} ${roomObj.roomnameen}`;
                 }

                 /**
                  * 保存
                  */
                const onSave=  () => {

                     let reqData = { ...model };
                     reqData.startDate = model.dateRange[0]
                     reqData.endDate = model.dateRange[1]

                     axios.post(`/Hotel/AddHotelRoom`, reqData).then(res=>{
                         top.window.vueElMessage({ message: res.data. message , type:  res.data.isSuccess?'success':'info' })
                         if(res.data.isSuccess){
                            parent.layer.close(frameIndex); // 关闭当前弹框
                         }
                     })
               }
              
                return {
                    model
                    ,maxAdultNumber
                    ,maxChildrenNumber
                    ,otaRoomList
                    ,roomDescribe
                    ,onRoomChange
                    ,onSave
                }
        }
        });
        app.use(ElementPlus);
        app.mount('#app');
    </script>
}


