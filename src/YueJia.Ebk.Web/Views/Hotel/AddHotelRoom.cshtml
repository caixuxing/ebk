@using YueJia.Ebk.Application.Contracts.SysApp
@using YueJia.Ebk.Domain.Shared.Enums
@using Newtonsoft.Json
@using Newtonsoft.Json.Serialization
@using YueJia.Ebk.Application.Contracts.OuterServiceApp
@model  YueJia.Ebk.Web.ViewModels.Hotel.AddHotelRoomVo
@inject ISysEnumApp enumApp
@inject IYueJiaSysServiceApp yueJiaSysServiceApp

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section head {
    <title>添加酒店房间</title>

    <style scoped>
		.el-input-number .el-input__inner{
        
        text-align:left !important;
        }
        </style>
}
<el-container style="height:100vh;overflow: hidden;">
    <el-main>
        <el-form :model="state.formData" label-width="auto" :rules="FormDataRules" ref="FormDataRef">
          
             <el-alert type="primary" show-icon :closable="false" >
            <p>[我的酒店] / <el-link type="primary" v-on:click="openViewHotel">@Html.Raw($"{Model.HotelName}")</el-link> / <el-link type="primary" v-on:click="openRoomAndPricePlan">房间与价格计划</el-link> / 库存与价格 / 促销</p>
             </el-alert>

           <el-form-item style="margin-top:30px">
                <h1>新增房间</h1>
            </el-form-item>
            <el-divider content-position="left">房间信息</el-divider>
            <el-form-item label="酒店名称">
                <el-input v-model="state.formData.hotelCode" autocomplete="off"  placeholder="酒店编码" style="width:50%;display:none"></el-input>
                <el-text class="mx-1">{{state.formData.hotelName}}</el-text>

            </el-form-item>
            <el-form-item label="房型" required prop="roomType" >
                  <el-select v-model="state.formData.roomType" placeholder="请选择房型"  filterable   style="width:50%"> 
                       <el-option v-for="option in state.roomTypeData" :key="option.value" :label="option.label" :value="option.value"  ></el-option>
                    </el-select>
            </el-form-item>
            <el-form-item label="床型"  required prop="bedType">
                   <el-select v-model="state.formData.bedType" placeholder="请选择床型"  filterable  style="width:50%"> 
                       <el-option v-for="option in state.bedTypeData" :key="option.value" :label="`${option.describe} ${option.name}`" :value="option.value"  ></el-option>
                    </el-select>
            </el-form-item>
            <el-form-item label="人数上限">
       
                    <el-select v-model="state.formData.maximumNumberOfPeople" placeholder="人数上限"  filterable  style="width:50%"> 
                       <el-option v-for="option in 24" :key="option" :label="option" :value="option"  ></el-option>
                    </el-select>

            </el-form-item>
            <el-form-item label="成人上限" label-width="auto">
             
                   <el-select v-model="state.formData.adultLimit" placeholder="成人上限"  filterable  style="width:50%"> 
                       <el-option v-for="option in state.formData.maximumNumberOfPeople" :key="option" :label="option" :value="option"  ></el-option>
                    </el-select>
            </el-form-item>
            <el-form-item label="儿童上限" label-width="auto">
               <el-select v-model="state.formData.childLimit" placeholder="儿童上限"  filterable  style="width:50%"> 
                       <el-option v-for="option in state.formData.maximumNumberOfPeople" :key="option-1" :label="option-1" :value="option-1"  ></el-option>
               </el-select>
            </el-form-item>
         <el-divider content-position="left" style="margin-top:50px">库存设置</el-divider>
              <el-form-item label="日期范围" label-width="auto" required prop="dateRange">
           


                               <el-date-picker is-range type="daterange" class="full-width-input"
                                                                v-model="state.formData.dateRange"
                                                                format="YYYY-MM-DD" value-format="YYYY-MM-DD" start-placeholder="开始日期" end-placeholder="结束日期"
                                                                clearable></el-date-picker>

            </el-form-item>
              <el-form-item label="房间库存" label-width="auto" required>
                  <div class="el-table--fit el-table--border el-table--scrollable-y el-table--enable-row-hover el-table el-table--layout-fixed is-scrolling-none" data-prefix="el" style="width: 100%; height: 100px;">
                      <div class="el-table__inner-wrapper">
                          <div class="el-table__header-wrapper">
                          <table class="el-table__header" border="0" cellpadding="0" cellspacing="0" style="width: 100%;">
                              <thead>
                                <tr>
                                      <th class="el-table_1_column_1 is-leaf el-table__cell" colspan="1" rowspan="1"><div class="cell">星期一</div></th>
                                      <th class="el-table_1_column_2 is-leaf el-table__cell" colspan="1" rowspan="1"><div class="cell">星期二</div></th>
                                      <th class="el-table_1_column_3 is-leaf el-table__cell" colspan="1" rowspan="1"><div class="cell">星期三</div></th>
                                      <th class="el-table_1_column_4 is-leaf el-table__cell" colspan="1" rowspan="1"><div class="cell">星期四</div></th>
                                      <th class="el-table_1_column_5 is-leaf el-table__cell" colspan="1" rowspan="1"><div class="cell">星期五</div></th>
                                      <th class="el-table_1_column_6 is-leaf el-table__cell" colspan="1" rowspan="1"><div class="cell">星期六</div></th>
                                      <th class="el-table_1_column_7 is-leaf el-table__cell" colspan="1" rowspan="1"><div class="cell">星期日</div></th>
                                  </tr>
                                </thead>
                                <tbody>
                                    <tr class="el-table__row">
                                        <td class="el-table__cell" colspan="1" rowspan="1"><div class="cell"> <el-input-number v-model="state.formData.stock.Monday" controls-position="right" style="width:100%" ></el-input-number></div> </td>
                                        <td class="el-table__cell" colspan="1" rowspan="1"><div class="cell"><el-input-number v-model="state.formData.stock.Tuesday" controls-position="right" style="width:100%" ></el-input-number></div></td>
                                        <td class="el-table__cell" colspan="1" rowspan="1"><div class="cell"><el-input-number v-model="state.formData.stock.Wednesday" controls-position="right" style="width:100%"></el-input-number></div></td>
                                        <td class="el-table__cell" colspan="1" rowspan="1"><div class="cell"><el-input-number v-model="state.formData.stock.Thursday" controls-position="right" style="width:100%"></el-input-number></div></td>
                                        <td class="el-table__cell" colspan="1" rowspan="1"><div class="cell"><el-input-number v-model="state.formData.stock.Friday" controls-position="right" style="width:100%"></el-input-number></div></td>
                                        <td class="el-table__cell" colspan="1" rowspan="1"><div class="cell"><el-input-number v-model="state.formData.stock.Saturday" controls-position="right" style="width:100%"></el-input-number></div></td>
                                        <td class="el-table__cell" colspan="1" rowspan="1"><div class="cell"><el-input-number v-model="state.formData.stock.Sunday" controls-position="right" style="width:100%"></el-input-number></div></td>
                                    </tr>
                                    </tbody>
                                  </table>
                               </div>
                           </div>
                   </div>
            </el-form-item>
            </el-form>


                    <el-form-item>
      <div class="dialog-footer" style="text-align: center; width: 100%;">
        <el-button type="primary" v-on:click="save" >保存 </el-button>
      </div>
            </el-form-item>
            
            



          
    </el-main>
</el-container>
@section scripts {
    <script type="text/javascript">
        const app = Vue.createApp({
        setup() {
                const state = Vue.reactive({
                    bedTypeData:@(Html.Raw(JsonConvert.SerializeObject(enumApp.GetEnumDataList(nameof(BedTypeEnum)), new JsonSerializerSettings { ContractResolver = new CamelCasePropertyNamesContractResolver() }))),
                    roomTypeData:@(Html.Raw(JsonConvert.SerializeObject( await yueJiaSysServiceApp.GetDropDownRoomTypeByHotelCodeAsync(Model.HotelCode), new JsonSerializerSettings { ContractResolver = new CamelCasePropertyNamesContractResolver() }))),
                    formData: {
                       hotelId: `@Html.Raw(Model.HotelId)`,
                       hotelCode: `@Html.Raw(Model.HotelCode)`,
                       hotelName: `@Html.Raw(Model.HotelName)`,
                       roomType:`@Html.Raw(Model.RoomType)`,
                       bedType:`@Html.Raw(Model.BedType)`,
                       maximumNumberOfPeople:@Html.Raw(Model.MaximumNumberOfPeople),
                       adultLimit:@Html.Raw(Model.AdultLimit),
                       childLimit:@Html.Raw(Model.ChildLimit),
                       dateRange:[`@(Html.Raw(Model.Stock.StartDate.ToString("yyyy-MM-dd")))`,`@(Html.Raw(Model.Stock.EndDate.ToString("yyyy-MM-dd")))`],
                       startDate:``,
                       endDate:``,
                        stock:{
                            Monday:@Html.Raw(Model.Stock.Stock.GetValueOrDefault(DayOfWeek.Monday)),
                            Tuesday:@Html.Raw(Model.Stock.Stock.GetValueOrDefault(DayOfWeek.Tuesday)),
                            Wednesday:@Html.Raw(Model.Stock.Stock.GetValueOrDefault(DayOfWeek.Wednesday)),
                            Thursday:@Html.Raw(Model.Stock.Stock.GetValueOrDefault(DayOfWeek.Thursday)),
                            Friday:@Html.Raw(Model.Stock.Stock.GetValueOrDefault(DayOfWeek.Friday)),
                            Saturday:@Html.Raw(Model.Stock.Stock.GetValueOrDefault(DayOfWeek.Saturday)),
                            Sunday:@Html.Raw(Model.Stock.Stock.GetValueOrDefault(DayOfWeek.Sunday)),
                        }

                    }
                    
                });
               const id=Vue.ref(`@Html.Raw(Model.HotelId)`);
               const FormDataRef = Vue.ref(null);
               const FormDataRules = {
                   roomType: [{ required: true, message: '房型必选!', trigger: 'blur' }],
                   bedType: [{ required: true, message: '床型必选!', trigger: 'blur' }],
                   dateRange: [{ type: 'daterange', required: true, message: '日期必填!', trigger: 'blur' }]
               };


                const save = async () => {
                let isValid = await FormDataRef.value.validate(); 
                if(!isValid) return ElMessage({ message: "请完善表单信息!", type: "error" });
                let requestData = { ...state.formData, startDate:state.formData.dateRange[0], endDate:state.formData.dateRange[1] };
                let response = await axios.post(`/Hotel/AddHotelRoom`, requestData);
                    if (response.status  === 200) {
                          ElMessage({ message: "保存成功!", type: "success" });
                          openRoomAndPricePlan();
                    }
                  
                     //window.parent.mainFrame(`/Hotel/HotelPublishList`,`我的酒店`,`page3-1`);
               }

           const openRoomAndPricePlan=()=> window.parent.mainFrame(`/Hotel/RoomAndPricePlan/${id.value}`,``,``);
          const openViewHotel=()=> window.parent.mainFrame(`/Hotel/ViewHotel/${id.value}`,``,``);

                const cancel=()=>{
                   window.parent.mainFrame(`/Hotel/HotelPublishList`,`我的酒店`,`page3-1`);
                 };
                return {state,save,cancel,FormDataRules,FormDataRef,openRoomAndPricePlan,openViewHotel }
        }
        });
        app.use(ElementPlus);
        app.mount('#app');
    </script>
}


