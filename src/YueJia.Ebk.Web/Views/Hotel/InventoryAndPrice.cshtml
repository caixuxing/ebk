@using YueJia.Ebk.Application.Contracts.SysApp
@using YueJia.Ebk.Web.ViewModels.Hotel
@model  YueJia.Ebk.Application.Contracts.HotelApp.Dto.InventoryAndPriceDto
@inject ISysEnumApp enumApp
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section head {
    <title>库存和价格</title>
    <style scoped>
		.el-input-number .el-input__inner{
        
        text-align:left !important;
        }
        </style>
}
<el-container style="height:100vh;overflow: hidden;">
    <el-main>
         <el-scrollbar>
        <el-form :model="state.formData" label-width="auto" :rules="FormDataRules" ref="FormDataRef">
            @await Html.PartialAsync("~/Views/Hotel/UserHotelNavigationMgr.cshtml", new ViewHotelVo{  Id=Model.HotelId,HotelName=Model.HotelName })
            <el-form-item style="margin-top:30px">
                <h1>库存和价格</h1>
            </el-form-item>
            <el-form-item label="酒店：">
                <el-text class="mx-1">{{state.formData.hotelName}}</el-text> <el-text class="mx-1">CNY</el-text>
            </el-form-item>
            <el-form-item label="房间名称：">
                  <el-row :gutter="20" style="width:100%">
                    <el-col :span="16">

                       <el-select v-model="state.formData.roomTypeValue" filterable placeholder="房型名称"  style="width: 240px" v-on:change="queryRoomAndPricePlan">
                  <el-option v-for="item in state.roomData" :key="item.value":label="item.label":value="item.value"></el-option>
                </el-select>

                          开始日期：<el-date-picker v-model="state.formData.startDate" type="date" placeholder="开始日期"   value-format="YYYY-MM-DD"
  format="YYYY-MM-DD"  v-on:change="queryRoomAndPricePlan"> </el-date-picker>
                          
                          
                          显示天数：
                          <el-select v-model="state.formData.showDays" placeholder="Select" style="width: 140px" v-on:change="queryRoomAndPricePlan">
                          <el-option key="7" label="7天" value="7" ></el-option>
                          <el-option key="14" label="14天" value="14" ></el-option>
                        </el-select>
                       <el-button type="primary" v-on:click="daysBeforeAndAfter(-state.formData.showDays)" :disabled="isDisabled"   style="margin-left:10px">前{{state.formData.showDays}}天</el-button>
                       <el-button type="primary" v-on:click="daysBeforeAndAfter(+state.formData.showDays)">后{{state.formData.showDays}}天</el-button>

                    </el-col>
                   
                  </el-row>

            </el-form-item>


            <el-form-item >
              <el-tag style="margin-right: 8px;" color="#2bb3f8" ></el-tag>等待提交
              <el-tag style="margin-right: 8px;margin-left: 10px" color="#E63415" ></el-tag>停售
              <el-tag style="margin-right: 8px;margin-left: 10px" color="#ef9d28" ></el-tag>无效（受上层状态影响）
              <el-tag style="margin-right: 8px; margin-left: 10px" color="#FF6600" ></el-tag>与相邻日期价格差距超过一倍
               
       


            </el-form-item>
            <el-form-item v-if="state.formData.room.dailyInventory.length>0">
              <div class="el-table--fit el-table--border el-table--scrollable-y el-table--enable-row-hover el-table el-table--layout-fixed is-scrolling-none" data-prefix="el" style="width: 100%;height:100%;">
                      <div class="el-table__inner-wrapper">
                          <table class="el-table__header" border="0" cellpadding="0" cellspacing="0" style="width: 100%;">
                              <thead>
                                  <tr><th class="el-table__cell" :colspan="state.formData.room.dailyInventory.length+1"> <div class="cell">  {{state.formData.room.hotelRoomTitle}} 
                                        <el-tag :type="state.formData.room.status==1?'success':'danger'" style="margin-left:20px">{{state.formData.room.statusName}} </el-tag>
                                  </div>
                                      
                           
                                  </th></tr>
                                  <tr><th class="el-table__cell" colspan="1" rowspan="1"><div class="cell"></div></th>
                                     
                                      <th class="el-table__cell" colspan="1" rowspan="1" v-for="item in state.formData.room.dailyInventory"><div class="cell" style="text-align:center"><p>{{item.monthDay}}</p><p>{{item.dayOfWeek}}</p></div></th>
                                  </tr>
                                </thead>
                                <tbody>
                                    <tr class="el-table__row">
                                        <td class="el-table__cell" width="20px"><div class="cell">库存</div> </td>
                                        <td class="el-table__cell" colspan="1" rowspan="1" v-for="item in state.formData.room.dailyInventory">
                                            <div class="cell" style="text-align:center">
                                              <el-input-number v-model="item.inventoryNum" :controls="false" style="width:80px"  :min="0" :max="10000"></el-input-number>    
                                            </div> 
                                            </td>
                                    </tr>
                                    <tr class="el-table__row">
                                        <td class="el-table__cell" colspan="1" rowspan="1"><div class="cell">切换状态</div> </td>


                                        <td class="el-table__cell" colspan="1" rowspan="1"  v-for="item in state.formData.room.dailyInventory">
                                            <div class="cell" style="text-align:center"> <el-switch v-model="item.status" inline-prompt active-text="是" inactive-text="否" /></div> </td>
         

                                    </tr>
                                    <template v-for="(item,index) in state.formData.room.pricePlan">

                                        <tr class="el-table__row">
                                    <td class="el-table__cell" :colspan="state.formData.room.pricePlan[index].dailyPrices.length+1" > <div class="cell">{{item.pricePlanName}}

                                        <el-tag :type="item.status==1?'success':'danger'" style="margin-left:20px">{{item.statusName}} </el-tag>
                                    </div> </td>
                                    </tr>
                                     <tr class="el-table__row">
                                        <td class="el-table__cell" width="20px"><div class="cell">价格(CNY)  </div> </td>
                                        <td class="el-table__cell" colspan="1" rowspan="1"  v-for="c in state.formData.room.pricePlan[index].dailyPrices">
                                            <div class="cell" style="text-align:center">
                                             <el-input-number v-model="c.price" :controls="false" style="width:80px" :precision="2" :min="0" :max="100000"></el-input-number>
                                            </div>
                                        </td>
                                       
                                    </tr>
                                    <tr class="el-table__row">
                                        <td class="el-table__cell" colspan="1" rowspan="1"><div class="cell">切换状态</div> </td>
                                        <td class="el-table__cell" colspan="1" rowspan="1"  v-for="c in state.formData.room.pricePlan[index].dailyPrices">
                                            <div class="cell" style="text-align:center"> <el-switch v-model="c.status" inline-prompt active-text="是" inactive-text="否" /></div>
                                       </td>
                                    </tr>

                                    </template>


                                    </tbody>
                                  </table>
                     </div>
                   </div>
            </el-form-item>
            </el-form>
            <el-alert  type="primary" :closable="false"  v-if="state.formData.room.dailyInventory.length<=0">
              <el-link type="primary" :underline="false" href="/Hotel/LoadingInventoryAndPrices/@Model.HotelId">当前房型暂无库存，前往添加。</el-link>    
            </el-alert>

             
           
            <el-form-item v-if="state.formData.room.dailyInventory.length>0">
            <div class="dialog-footer" style="text-align: center; width: 100%;">
                <el-button type="primary" v-on:click="save">保存 </el-button>
            </div>
        </el-form-item>
        </el-scrollbar>
    </el-main>
 
</el-container>
@section scripts {
    <script type="text/javascript" setup>
        const app = Vue.createApp({
        setup() { 
            const state = Vue.reactive({
                roomData:@(Html.Raw(JsonConvert.SerializeObject(Model.RoomDropDownList, new JsonSerializerSettings { ContractResolver = new CamelCasePropertyNamesContractResolver() }))),
                formData: {
                    hotelId: `@(Html.Raw(Model.HotelId))`,
                    hotelName: `@(Html.Raw($"{Model.HotelName}({Model.HotelNameEn})"))`,
                    roomTypeValue: `@(Html.Raw(Model.RoomTypeValue))`,
                    startDate: `@Html.Raw(Model.StartDate.ToString("yyyy-MM-dd"))`,
                    showDays: `@Html.Raw(Model.ShowDays)`,
                    room:@(Html.Raw(JsonConvert.SerializeObject(Model.RoomTypeInfo, new JsonSerializerSettings { ContractResolver = new CamelCasePropertyNamesContractResolver() }))),
                }
            });

           
            const isDisabled = Vue.ref(false);



            const queryRoomAndPricePlan = () => {


               const now = new Date();
               let currentTime = now.toISOString().split('T')[0]; 
               const targetDate = new Date(state.formData.startDate);
               isDisabled.value = targetDate<now ;

               let reqData = { ...state.formData };
                    axios.post(`/Hotel/InventoryAndPriceDetailsByFilter`, {
                        hotelId:state.formData.hotelId,
                       roomId:state.formData.roomTypeValue,
                       startDate:state.formData.startDate,
                       days:Number(state.formData.showDays)
                    }).then(function (response) {
                        state.formData.room = response.data.data;
                        })
                       .catch(function (error) {
                            console.log(error);
                        });
                }

                  const daysBeforeAndAfter=(days) => {
      
                   state.formData.startDate=addDays(state.formData.startDate,days);
                    queryRoomAndPricePlan();
                  }

                const addDays=(dateString, days)=> {
                  const date = new Date(dateString);
                  date.setDate(date.getDate() + days);
                  const year = date.getFullYear();
                  const month = String(date.getMonth() + 1).padStart(2, '0');
                  const day = String(date.getDate()).padStart(2, '0');
                  return `${year}-${month}-${day}`;
                }

   

            const save = () => {
                let inventorys = state.formData.room.dailyInventory.map(({ inventoryId, inventoryNum, status }) => ({ inventoryId,inventoryNum, status:status ? 1 : 0  }));
                let prices = state.formData.room.pricePlan.flatMap(pricePlan =>pricePlan.dailyPrices.map(({ priceId, price, status }) => ({ priceId, price, status:status ? 1 : 0  })));
                let reqData = { ...state.formData };
                    axios.post(`/Hotel/SaveInventoryAndPrice`, { inventorys:inventorys, prices:prices}).then(function (response) {
                            if (response.data.isSuccess) {
                                ElementPlus.ElMessage.success('保存成功');
                            } else {
                                ElementPlus.ElMessage.error('保存失败');
                            }
                        })
                       .catch(function (error) {
                            console.log(error);
                        });


            }

            return {
                state,
                save,queryRoomAndPricePlan,daysBeforeAndAfter,isDisabled
            };
        }
        });
        app.use(ElementPlus, { locale: ElementPlusLocaleZhCn });
        app.mount('#app');
    </script>
}


