@using YueJia.Ebk.Application.Contracts.SysApp
@using YueJia.Ebk.Web.ViewModels.Hotel
@model  YueJia.Ebk.Application.Contracts.HotelApp.Dto.InventoryAndPriceDto
@inject ISysEnumApp enumApp
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section head {
    <title>库存和价格</title>
    <style scoped>
		.el-input-number .el-input__inner{
        
        text-align:left !important;
        }
        </style>
}
<el-container style="height:100vh;overflow: hidden;">
    <el-main>
        <el-form :model="state.formData" label-width="auto" :rules="FormDataRules" ref="FormDataRef">
            @await Html.PartialAsync("~/Views/Hotel/UserHotelNavigationMgr.cshtml", new ViewHotelVo{  Id=Model.HotelId,HotelName=Model.HotelName })
            <el-form-item style="margin-top:30px">
                <h1>库存和价格</h1>
            </el-form-item>
            <el-form-item label="酒店：">
                <el-text class="mx-1">{{state.formData.hotelName}}</el-text> <el-text class="mx-1">CNY</el-text>
            </el-form-item>
            <el-form-item label="房间名称：">
                  <el-row :gutter="20" style="width:100%">
                    <el-col :span="16">

                       <el-select v-model="value" placeholder="Select" style="width: 240px">
                          <el-option key="7" label="7" value="7" ></el-option>
                          <el-option key="14" label="14" value="14" ></el-option>
                        </el-select>

                          开始日期：<el-date-picker v-model="state.formData.startDate" type="date" placeholder="开始日期" :size="size"> </el-date-picker>
                          显示天数：
                          <el-select v-model="state.formData.showDays" placeholder="Select" style="width: 140px">
                          <el-option key="7" label="7天" value="7" ></el-option>
                          <el-option key="14" label="14天" value="14" ></el-option>
                        </el-select>
                       <el-button type="primary">前14天</el-button>
                          <el-button type="primary">后14天</el-button>

                    </el-col>
                   
                  </el-row>

            </el-form-item>

            <el-form-item label="房型名称：">
                 <el-select v-model="state.formData.roomTypeValue" filterable placeholder="房型名称"  >
                  <el-option v-for="item in state.roomData" :key="item.value":label="item.label":value="item.value"></el-option>
                </el-select>
            </el-form-item>

            <el-form-item >
                 <el-text class="mx-1">等待提交</el-text>
                     <el-text class="mx-1">停售</el-text>
                         <el-text class="mx-1">无效</el-text>
            </el-form-item>
            <el-form-item>
              <div class="el-table--fit el-table--border el-table--scrollable-y el-table--enable-row-hover el-table el-table--layout-fixed is-scrolling-none" data-prefix="el" style="width: 100%; height: 360px;">
                      <div class="el-table__inner-wrapper">
                         
                          <table class="el-table__header" border="0" cellpadding="0" cellspacing="0" style="width: 100%;">
                              <thead>
                                  <tr><th class="el-table__cell" colspan="8"> <div class="cell">  {{state.formData.room.name}} </div></th></tr>
                                  <tr><th class="el-table__cell" colspan="1" rowspan="1"><div class="cell"></div></th>
                                     
                                      <th class="el-table__cell" colspan="1" rowspan="1" v-for="item in state.formData.room.inventory"><div class="cell" style="text-align:center"><p>{{item.monthDay}}</p><p>{{item.dayOfWeek}}</p></div></th>
                                  </tr>
                                </thead>
                                <tbody>
                                    <tr class="el-table__row">
                                        <td class="el-table__cell" width="20px"><div class="cell">库存</div> </td>
                                        <td class="el-table__cell" colspan="1" rowspan="1" v-for="item in state.formData.room.inventory">
                                            <div class="cell"> <el-input-number v-model="item.inventoryNum" controls-position="right" style="width:100%" ></el-input-number></div> 
                                            </td>
                                    </tr>
                                    <tr class="el-table__row">
                                        <td class="el-table__cell" colspan="1" rowspan="1"><div class="cell">切换状态</div> </td>


                                        <td class="el-table__cell" colspan="1" rowspan="1"  v-for="item in state.formData.room.inventory">
                                            <div class="cell" style="text-align:center"> <el-switch v-model="item.status" inline-prompt active-text="是" inactive-text="否" /></div> </td>
         

                                    </tr>
                                    <tr class="el-table__row">
                                    <td class="el-table__cell" colspan="8" > <div class="cell">{{state.formData.pricePlan.name}}</div> </td>
                                    </tr>
                                        <tr class="el-table__row">
                                        <td class="el-table__cell" width="20px"><div class="cell">价格(CNY)</div> </td>
                                        <td class="el-table__cell" colspan="1" rowspan="1"  v-for="item in state.formData.pricePlan.prices">
                                            <div class="cell"> <el-input-number v-model="item.price" controls-position="right" style="width:100%" ></el-input-number></div>
                                        </td>
                                       
                                    </tr>
                                    <tr class="el-table__row">
                                        <td class="el-table__cell" colspan="1" rowspan="1"><div class="cell">切换状态</div> </td>
                                        <td class="el-table__cell" colspan="1" rowspan="1"  v-for="item in state.formData.pricePlan.prices">
                                            <div class="cell" style="text-align:center"> <el-switch v-model="item.status" inline-prompt active-text="是" inactive-text="否" /></div>
                                       </td>
                                    </tr>


                                    </tbody>
                                  </table>
                               </div>
                         
                   </div>
                  
            </el-form-item>
            </el-form>
            <el-alert title="当前房型暂无库存，前往添加。" type="primary" :closable="false" v-on:click="openRoomAndPricePlan" v-if="state.formData.stock!=null"></el-alert>
                       <el-form-item>
            <div class="dialog-footer" style="text-align: center; width: 100%;">
                <el-button type="primary" v-on:click="save">保存 </el-button>
            </div>
        </el-form-item>
    </el-main>
 
</el-container>
@section scripts {
    <script type="text/javascript">
        const app = Vue.createApp({
        setup() { 
            const state = Vue.reactive({
                roomData:@(Html.Raw(JsonConvert.SerializeObject(Model.RoomDropDownList, new JsonSerializerSettings { ContractResolver = new CamelCasePropertyNamesContractResolver() }))),
                formData: {
                    hotelName: `@(Html.Raw($"{Model.HotelName}({Model.HotelNameEn})"))`,
                    roomName: '2222222222',
                    roomTypeValue: `@(Html.Raw(Model.RoomTypeValue))`,
                    startDate: `@Html.Raw(Model.StartDate.ToString("yyyy-MM-dd"))`,
                    showDays: `@Html.Raw(Model.ShowDays)`,
                    room:@(Html.Raw(JsonConvert.SerializeObject(Model.RoomTypeInfo, new JsonSerializerSettings { ContractResolver = new CamelCasePropertyNamesContractResolver() }))),

                     FormDataRules: {
                        stock: {
                            Monday: [
                                { required: true, message: '请输入星期一的库存', trigger: 'blur' },
                                { type: 'number', message: '请输入正确的数字', trigger: 'blur' }
                            ],
                            Tuesday: [
                                { required: true, message: '请输入星期二的库存', trigger: 'blur' },
                                { type: 'number', message: '请输入正确的数字', trigger: 'blur' }
                            ],
                            Wednesday: [
                                { required: true, message: '请输入星期三的库存', trigger: 'blur' },
                                { type: 'number', message: '请输入正确的数字', trigger: 'blur' }
                            ],
                            Thursday: [
                                { required: true, message: '请输入星期四的库存', trigger: 'blur' },
                                { type: 'number', message: '请输入正确的数字', trigger: 'blur' }
                            ],
                            Friday: [
                                { required: true, message: '请输入星期五的库存', trigger: 'blur' },
                                { type: 'number', message: '请输入正确的数字', trigger: 'blur' }
                            ],
                            Saturday: [
                                { required: true, message: '请输入星期六的库存', trigger: 'blur' },
                                { type: 'number', message: '请输入正确的数字', trigger: 'blur' }
                            ],
                            Sunday: [
                                { required: true, message: '请输入星期日的库存', trigger: 'blur' },
                                { type: 'number', message: '请输入正确的数字', trigger: 'blur' }
                            ]
                        }
                    }
                }
            });

            const FormDataRef = Vue.ref(null);

            const openRoomAndPricePlan = () => {
                window.location.href = '/Hotel/RoomAndPricePlan';
            }

            const changeRoom = () => {
                

                }

            const save = () => {
                FormDataRef.value.validate((valid) => {
                    if (valid) {
                        console.log(state.formData);
                        alert('保存成功');
                    } else {
                        console.log('error submit!!');
                        return false;
                    }
                });
            }

            return {
                state,
                FormDataRef,
                openRoomAndPricePlan,
                save
            };
        }
        });
        app.use(ElementPlus);
        app.mount('#app');
    </script>
}


