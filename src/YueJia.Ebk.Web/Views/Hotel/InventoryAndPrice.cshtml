@section scripts {
    <script type="text/javascript">
        const app = Vue.createApp({
        setup() { 
        
            const state = Vue.reactive({
                formData: {
                    stock: {
                        Monday: 0,
                        Tuesday: 0,
                        Wednesday: 0,
                        Thursday: 0,
                        Friday: 0,
                        Saturday: 0,
                        Sunday: 0
                    }
                },
                FormDataRules: {
                    stock: {
                        Monday: [
                            { required: true, message: '请输入星期一的库存', trigger: 'blur' },
                            { type: 'number', message: '请输入正确的数字', trigger: 'blur' }
                        ],
                        Tuesday: [
                            { required: true, message: '请输入星期二的库存', trigger: 'blur' },
                            { type: 'number', message: '请输入正确的数字', trigger: 'blur' }
                        ],
                        Wednesday: [
                            { required: true, message: '请输入星期三的库存', trigger: 'blur' },
                            { type: 'number', message: '请输入正确的数字', trigger: 'blur' }
                        ],
                        Thursday: [
                            { required: true, message: '请输入星期四的库存', trigger: 'blur' },
                            { type: 'number', message: '请输入正确的数字', trigger: 'blur' }
                        ],
                        Friday: [
                            { required: true, message: '请输入星期五的库存', trigger: 'blur' },
                            { type: 'number', message: '请输入正确的数字', trigger: 'blur' }
                        ],
                        Saturday: [
                            { required: true, message: '请输入星期六的库存', trigger: 'blur' },
                            { type: 'number', message: '请输入正确的数字', trigger: 'blur' }
                        ],
                        Sunday: [
                            { required: true, message: '请输入星期日的库存', trigger: 'blur' },
                            { type: 'number', message: '请输入正确的数字', trigger: 'blur' }
                        ]
                    }       
                }
            });

            const FormDataRef = Vue.ref(null);

            const openRoomAndPricePlan = () => {
                window.location.href = '/Hotel/RoomAndPricePlan';
            }

            const save = () => {
                FormDataRef.value.validate((valid) => {
                    if (valid) {
                        console.log(state.formData);
                        alert('保存成功');
                    } else {
                        console.log('error submit!!');
                        return false;
                    }
                });
            }

            return {
                state,
                FormDataRef,
                openRoomAndPricePlan,
                save
            };
        
        }
        });
        app.use(ElementPlus);
        app.mount('#app');
    </script>
}


