<el-container style="height:100vh;overflow: hidden;">
    <el-main>
        <el-form label-width="auto" :inline="true">
            <div>
                <el-form-item label="酒店编码" style="margin-bottom:5px;">
                    <el-input v-model="state.qry.hotelCode" clearable style="width:200px"></el-input>
                </el-form-item>
                   <el-form-item label="酒店名称" style="margin-bottom:5px;">
                    <el-input v-model="state.qry.hotelName" clearable style="width:200px"></el-input>
                </el-form-item>
                <el-form-item label="状态"  style="margin-bottom:5px;">
                    <el-select v-model="state.qry.status" placeholder="不限" style="width:220px;" clearable filterable>
                       <el-option v-for="item in state.saleTypeData" :key="item.value" :label="item.describe" :value="item.value"/>
                    </el-select>
                </el-form-item>


                <el-form-item prop="desc" style="margin-bottom:5px;">
                    <el-button type="primary" v-on:click="pageIndex=1;loadData()" id="query">查询</el-button>
                    <el-button v-on:click="resetQueryForm">重置</el-button>
                </el-form-item>
            </div>
        </el-form>
        <el-form label-width="100px" :inline="true" style="margin-top:30px;">
            <el-form-item prop="desc" style="margin-bottom:5px;">
                <el-button type="primary" v-on:click="userAddHotel">添加酒店</el-button>
            </el-form-item>
        </el-form>
        <el-table :data="state.dataList"
                  border
                  height="100%" >
            <el-table-column label="#" width="60" align="center">
                <template #default="scope">
                    <div style="text-align:left">
                        <span>{{ (state.qry.pageIndex-1) * state.qry.pageSize + scope.$index +1   }}</span>
                    </div>
                </template>
            </el-table-column>
            <el-table-column label="酒店编码" width="130px" align="center"  >
                <template #default="scope">
                    <label v-on:click="onViewHotel(scope.row)" style="color: #1890ff;cursor: pointer; ">{{ scope.row.hotelCode }}</label>
                </template>
            </el-table-column>
            <el-table-column label="酒店名称" width="300px" align="center">
                <template #default="scope">
                    <div style="text-align:left" >
                        <p style="margin:5px 0px">{{ scope.row.hotelName }}</p>
                        <p>{{ scope.row.hotelNameEn }}</p>
                    </div>
             
                </template>
            </el-table-column>
            <el-table-column label="酒店地址" width="auto" max-width="200px" align="center">
                <template #default="scope">
                    <div style="text-align:left" >
                        <p>[{{scope.row.countryIosCode}}]{{scope.row.countryName}},{{scope.row.cityName}}</p>
                        <p>{{ scope.row.addressEn }}</p>
                    </div>
                </template>
            </el-table-column>
            <el-table-column label="联系电话" width="200px" align="center"  >
                <template #default="scope" >
                    <div style="text-align:left" >
                        {{ scope.row.telPhone }}
                    </div>
                </template>
            </el-table-column>

             <el-table-column label="销售状态" width="120px" align="center">
                <template #default="scope">
                    <div style="text-align:center">
                        <span>{{  scope.row.statusName }}</span>
                    </div>
                </template>
            </el-table-column>

            <el-table-column label="操作" prop="opt" width="140px" align="center">
                <template #default="scope">
                    <div style="text-align:center">
                        <el-button size="small" v-on:click="onViewHotel(scope.row)">查看</el-button>
                        <el-button size="small" type="danger" v-on:click="onDelete(scope.row)">删除 </el-button>
                    </div>
                </template>
            </el-table-column>

        </el-table>
        <div style=" height:35px;padding: 10px 0px 0px 20px; ">
            <el-pagination v-model:current-page="state.qry.pageIndex"
                           v-model:page-size="state.qry.pageSize"
                           :page-sizes="[20, 50, 100,500]"
                           layout="total, sizes, prev, pager, next, jumper"
                           :total="state.qry.totalCount"
                           v-on:size-change="handleSizeChange"
                           v-on:current-change="handleCurrentChange" style="float:right;"></el-pagination>

        </div>
    </el-main>
</el-container>





@section scripts {
    <script type="text/javascript">
        const app = Vue.createApp({
        setup() {

           let qry = {  hotelCode: '',hotelName: '',status: null,pageIndex: 1,pageSize: 50,totalCount: 0 }

           const state = Vue.reactive({
                qry:  JSON.parse(JSON.stringify( qry)),
                saleTypeData:@(Html.Raw(ViewBag.HotelSaleTypeData)),
                dataList: []
            });

            Vue.onMounted(() => { loadData()  });

            const loadData = () => {
                       axios.post(`/hotel/HotelPublishListData`, {...state.qry}).then(response => {
                         let {data,status}=response;
                         state.dataList = data.data.list;
                          state.qry.totalCount = data.data.total;
                     })
             };

             const handleSizeChange = (val) => {
                     state.qry.pageIndex = 1;
                     state.qry.pageSize = val;
                     loadData();
             };
             const handleCurrentChange = (val) => {
                     state.qry.pageIndex = val;
                     loadData();
            };


            const onDelete =  (row) => {
                    ElMessageBox.confirm('您确定删除吗?', { confirmButtonText: '确定', cancelButtonText: '取消', type: 'warning', }).then(() => {
                        axios.delete(`/hotel/${row.id}/delete`).then(res => {
                                          top.window.vueElMessage({ message: res.data. message , type:  res.data.isSuccess?'success':'info' })
                                          if(res.data.isSuccess){
                                             loadData();
                                          }
                            })
                    })
              }


             const resetQueryForm=()=>{
                 state.qry  = JSON.parse(JSON.stringify( qry))
              };


              /**
               * 添加酒店
               */
             const userAddHotel=()=>{

                    layer.open({
                         type: 2,
                         title: '添加酒店',
                         area: ['90%', '80%'],
                         fix: false,
                         maxmin: true,
                         content:  "/Hotel/UserAddHotelMgr",
                         end: function () {
                            state.qry.pageIndex = 1;
                            loadData();
                         }
                     });
               }

               const onViewHotel=(row)=>{
                    window.location.href =`/Hotel/ViewHotel/${row.id}`
               };

                return {
                        state
                        ,loadData
                        ,handleSizeChange
                        ,handleCurrentChange
                        ,onDelete
                        ,resetQueryForm
                        ,userAddHotel
                        ,onViewHotel
                    }
            }});
            app.use(ElementPlus,{ locale: ElementPlusLocaleZhCn });
            app.mount('#app');
    </script>

}