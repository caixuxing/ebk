@inject  YueJia.Ebk.Application.Contracts.SysUserApp.ICurrentUserApp currentUser
@using YueJia.Ebk.Domain.Shared.Utils

<el-container style="height:100vh;overflow: hidden;">
    <el-main>
        <el-form label-width="100px" :inline="true">
            <div>
                <el-form-item label="公司名称" prop="desc" style="margin-bottom:5px;">
                    <el-input v-model="state.qry.name" placeholder="公司名称" clearable  style="width:200px"  ></el-input>
                </el-form-item>
                <el-form-item label="责任人" prop="desc" style="margin-bottom:5px;" >
                    <el-input v-model="state.qry.responsible" placeholder="责任人" clearable style="width:200px" ></el-input>
                </el-form-item>
              
                 <el-form-item label="状态" prop="desc" style="margin-bottom:5px;">
                      <el-select v-model="state.qry.status" placeholder="不限" clearable style="width:200px" >
                        <el-option label="是" value="1"></el-option>
                        <el-option label="否" value="2"></el-option>
                      </el-select>
                </el-form-item>
                <el-form-item prop="desc" style="margin-bottom:5px;">
                    <el-button type="primary" v-on:click="pageIndex=1;loadData()" >查询</el-button>
                    <el-button v-on:click="resetQueryForm">重置</el-button>
                </el-form-item>
            </div>
        </el-form>
       <el-form label-width="100px" :inline="true" style="margin-top:30px;">
            <div>
                <el-form-item prop="desc" style="margin-bottom:5px;">
                     @if (currentUser.AccountType==YueJia.Ebk.Domain.Shared.Enums.AccountTypeEnum.SuperAdmin)
                        {
                        <el-button type="primary" v-on:click="onNew()">新增</el-button>
                        }
                </el-form-item>
            </div>
        </el-form>
        <el-table :data="state.dataList"
                  border
                  height="100%"
                 >
            <el-table-column label="#" width="60" align="center">
                <template #default="scope">
                    <div style="text-align:left">
                        <span>{{ (state.qry.pageIndex-1) * state.qry.pageSize + scope.$index +1   }}</span>
                    </div>
                </template>
            </el-table-column>
            <el-table-column label="公司名称" width="auto" max-width="200" align="center"  >
                <template #default="scope">
                    <div style="text-align:left" >
                        {{ scope.row.name }}
                    </div>
                </template>
            </el-table-column>
               <el-table-column label="责任人" width="120px" align="center"  >
                <template #default="scope">
                    <div style="text-align:left">
                        {{ scope.row.responsible }}
                    </div>
                </template>
            </el-table-column>
               <el-table-column label="联系电话" width="140px" align="center"  >
                <template #default="scope" >
                    {{ scope.row.contactPhone }}
                </template>
            </el-table-column>
               <el-table-column label="邮箱" width="auto" max-width="120" align="center"  >
                <template #default="scope" >
                    <div style="text-align:left">
                        {{ scope.row.email }}
                    </div>
                </template>
            </el-table-column>
             <el-table-column label="渠道管理" width="115px" align="center"  >
                <template #default="scope">
                    {{ scope.row.isChannelManageName }}
                </template>
            </el-table-column>
            <el-table-column label="状态" width="60px" align="center">
                <template #default="scope">
                    <div style="text-align:center">
                        <span>{{  scope.row.statusName }}</span>
                    </div>
                </template>
            </el-table-column>
             <el-table-column label="创建日期" width="160px" align="center">
                <template #default="scope">
                    <div style="text-align:right">
                        <p style="margin:0px;text-align:center">{{ scope.row.createTime}}</p>
                    </div>
                </template>
            </el-table-column>

            <el-table-column label="操作" prop="opt" width="240px" align="center">
                <template #default="scope">
                    <div style="text-align:center">
                        <el-button size="small" v-on:click="assignChannels(scope.row)">配置渠道</el-button>
                        <el-button size="small" v-on:click="onEdit(scope.row)">编辑</el-button>
                        @if (currentUser.AccountType==YueJia.Ebk.Domain.Shared.Enums.AccountTypeEnum.SuperAdmin)
                        {
                         <el-button size="small" type="danger" v-on:click="onDelete(scope.row)">删除 </el-button>
                        }
                    </div>
                </template>
            </el-table-column>

        </el-table>
        <div style=" height:35px;padding: 10px 0px 0px 20px; ">
            <el-pagination v-model:current-page="state.qry.pageIndex"
                           v-model:page-size="state.qry.pageSize"
                           :page-sizes="[20, 50, 100,500]"
                           layout="total, sizes, prev, pager, next, jumper"
                           :total="state.qry.totalCount"
                           v-on:size-change="handleSizeChange"
                           v-on:current-change="handleCurrentChange" style="float:right;"></el-pagination>
        </div>
    </el-main>
</el-container>

   
@section scripts {

    <script type="module">
        const app = Vue.createApp({
        setup() {
            let qry = {  name: '',responsible: '',status: null,pageIndex: 1,pageSize: 50,totalCount: 0 }

            const state = Vue.reactive({
                qry:  JSON.parse(JSON.stringify( qry)),
                dataList: []
            });
    
           Vue.onMounted(() => { loadData()  });

            const loadData = () => {
                axios.post(`/Company/PageList`, {...state.qry}).then(response => {
                    let {data,status}=response;
                    state.dataList = data.data.list;
                    state.totalCount = data.data.total;
                })
             };

            const handleSizeChange = (val) => {
                    state.qry.pageIndex = 1;
                    state.qry.pageSize = val;
                    loadData();
            };
            const handleCurrentChange = (val) => {
                    state.qry.pageIndex = val;
                    loadData();
           };

           /**
            * 新增
            */
           const onNew = () => {
                    layer.open({
                        type: 2,
                        title: '新增',
                        area: ['600px', '480px'],
                        fix: false,
                        maxmin: true,
                        content:  "/Company/AddEditMgr?id=0",
                        end: function () {
                           state.qry.pageIndex = 1;
                           loadData();
                        }
                    });
           };

          /**
            * 编辑
            */
           const onEdit=(row)=>{
                    layer.open({
                        type: 2,
                        title: '编辑',
                        area: ['600px', '480px'],
                        fix: false,
                        maxmin: true,
                        content:  "/Company/AddEditMgr?id="+row.id,
                        end: function () {
                           loadData();
                        }
                    });
            }

            /*
            * 删除
            */
            const onDelete =  (row) => {

                  ElMessageBox.confirm('您确定删除吗?', { confirmButtonText: '确定', cancelButtonText: '取消', type: 'warning', }) .then(() => {

                             axios.delete(`/Company/${row.id}/delete`).then(res => {
                                      top.window.vueElMessage({ message: res.data. message ,icon:'' })
                                      if(res.data.isSuccess){
                                         loadData();
                                      }
                            })
                    })
              }
           
                //重置查询表单
              const resetQueryForm=()=>{
                 state.qry  = JSON.parse(JSON.stringify( qry))
               };

             const assignChannels = (row) => {
                    layui.use(function () {
                        var layer = layui.layer;
                        layer.open({
                            type: 2,
                            area: ['560px', '300px'],
                            title: " 分配渠道",
                            fix: true,
                            maxmin: false,
                            shade: 0.6, //遮罩透明度
                            shadeClose: false,//点击遮罩关闭
                            anim: 0,
                            content: `Company/AssignChannel/${row.id}`,
                            resize:false
                        });
                    });
                }

            return {
                state,
                loadData,
                handleSizeChange,
                handleCurrentChange,
                onDelete,
                resetQueryForm, 
                assignChannels,
                onNew,
                onEdit
                };
              }
            });
            app.use(ElementPlus,{ locale: ElementPlusLocaleZhCn });
            app.mount('#app');
    </script>

}