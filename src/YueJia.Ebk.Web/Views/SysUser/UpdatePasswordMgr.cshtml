
<el-container style="height:100vh;overflow: hidden; padding-top:20px; text-align:center ">
    <el-main>
        <el-form label-width="auto" :model="model" >
            <el-form-item label="当前密码"  >
                <el-input v-model="model.oldPassword" autocomplete="off" clearable  maxlength="20"></el-input>
            </el-form-item>
            <el-form-item label="新密码" required >
                <el-input v-model="model.newFirstPassword" autocomplete="off" clearable maxlength="20"></el-input>
            </el-form-item>
            <el-form-item label="确认密码" required >
                <el-input v-model="model.newConfirmPassword" autocomplete="off" clearable maxlength="20"></el-input>
            </el-form-item>
        </el-form>
    </el-main>
    <el-footer>
            <el-button type="primary" v-on:click="onEnd">保存 </el-button>
    </el-footer>
</el-container>

@section scripts {
    <script type="text/javascript">

        var frameIndex = parent.layer.getFrameIndex(window.name);

        const app = Vue.createApp({
            setup() {

                const model =  Vue.reactive(
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new YueJia.Ebk.Application.Contracts.SysUserApp.Commands.UpdatePasswordSysUserCmd(), new System.Text.Json.JsonSerializerOptions() { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }))
                );


                /*
                * 保存
                */
                const onEnd =  () => {
                     let reqData = { ...model };
                         axios.put(`/SysUser/updatePassword`, reqData).then(res=>{
                             top.window.vueElMessage({ message: res.data. message , type:  res.data.isSuccess?'success':'info' })
                             if(res.data.isSuccess){
                                parent.layer.close(frameIndex); // 关闭当前弹框
                             }
                         })
                 }

                return {
                       model,
                       onEnd
                 };
            }
        });
        app.use(ElementPlus, { locale: ElementPlusLocaleZhCn });
        app.mount('#app');
    </script>

}