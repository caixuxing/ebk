<el-container style="height:100vh;overflow: hidden;">
    <el-main>
        <el-form label-width="100px" :inline="true">
            <div>
                <el-form-item label="登录账户" prop="desc" style="margin-bottom:5px;">
                    <el-input v-model="state.qry.accountName" clearable style="width:200px"></el-input>
                </el-form-item>
                
                <el-form-item label="状态" prop="desc" style="margin-bottom:5px;">
                    <el-select v-model="state.qry.isEnabled" placeholder="不限" clearable style="width:200px" >
                        @foreach (YueJia.Ebk.Application.Contracts.SysApp.Dto.EnumDto ele in ViewBag.YesOrNoTypeList)
                        {
                            <el-option label="@ele.Describe" value="@ele.Value"></el-option>
                        }
                    </el-select>
                </el-form-item>
                <el-form-item prop="desc" style="margin-bottom:5px;">
                    <el-button type="primary" v-on:click="pageIndex=1;loadData()" id="query">查询</el-button>
                    <el-button v-on:click="resetQueryForm">重置</el-button>
                </el-form-item>
            </div>
        </el-form>
               <el-form label-width="100px" :inline="true" style="margin-top:30px;">
                <el-form-item prop="desc" style="margin-bottom:5px;">
                <el-button type="primary" v-on:click="onNew">新增</el-button>
                </el-form-item>
        </el-form>
        <el-table :data="state.dataList"
                  border
                  height="100%"
                 >
            <el-table-column label="#" width="60" align="center">
                <template #default="scope">
                    <div style="text-align:left">
                        <span>{{ (state.qry.pageIndex-1) * state.qry.pageSize + scope.$index +1   }}</span>
                    </div>
                </template>
            </el-table-column>
            <el-table-column label="用户名" width="180px" align="center">
                <template #default="scope">
                    <div style="text-align:left">
                        {{ scope.row.realName }}
                    </div>
                </template>
            </el-table-column>
               <el-table-column label="登录账户" width="auto" max-width="200px" align="center"  >
                <template #default="scope">
                    <div style="text-align:left">
                        {{ scope.row.accountName }}
                    </div>
                </template>
            </el-table-column>
               <el-table-column label="联系电话" width="140px" align="center"  >
                <template #default="scope" align="right">
                    {{ scope.row.contactPhone }}
                </template>
            </el-table-column>
               <el-table-column label="部门" width="auto" max-width="120px" align="center"  >
                <template #default="scope">
                    <div style="text-align:left" >
                        {{ scope.row.deptName }}
                    </div>
                </template>
            </el-table-column>
            
            <el-table-column label="是否启用" width="120px" align="center">
                <template #default="scope">
                    <div style="text-align:center">
                        <span>{{  scope.row.isEnabledName }}</span>
                    </div>
                </template>
            </el-table-column>
               <el-table-column label="是否部门管理" width="120px" align="center">
                <template #default="scope">
                    <div style="text-align:center">
                        <span>{{  scope.row.deptAdminNam }}</span>
                    </div>
                </template>
            </el-table-column>

             <el-table-column label="账户类型" width="120px" align="center">
                <template #default="scope">
                    <div style="text-align:center">
                        <span>{{  scope.row.accountTypeName }}</span>
                    </div>
                </template>
            </el-table-column>

             <el-table-column label="创建日期" width="160px" align="center">
                <template #default="scope">
                    <div style="text-align:right">
                        <p style="margin:0px;text-align:center">{{ scope.row.createTime}}</p>
                    </div>
                </template>
            </el-table-column>

            <el-table-column label="操作" prop="opt" width="240px" align="center">
                <template #default="scope">
                    <div style="text-align:center">
                        <el-button size="small" v-on:click="onResetPassword(scope.row)">重置密码</el-button>
                        <el-button size="small" v-on:click="onEdit(scope.row)">编辑</el-button>
                        <el-button size="small" type="danger" v-on:click="onDelete(scope.row)">删除 </el-button>
                    </div>
                </template>
            </el-table-column>

        </el-table>
        <div style=" height:35px;padding: 10px 0px 0px 20px; ">
            <el-pagination v-model:current-page="state.qry.pageIndex"
                           v-model:page-size="state.qry.pageSize"
                           :page-sizes="[20, 50, 100,500]"
                           layout="total, sizes, prev, pager, next, jumper"
                           :total="state.qry.totalCount"
                           v-on:size-change="handleSizeChange"
                           v-on:current-change="handleCurrentChange" style="float:right;"></el-pagination>

        </div>
    </el-main>
</el-container>

@section scripts {
    <script type="text/javascript">
        const app = Vue.createApp({
        setup() {

           let qry = {  accountName: '',isEnabled: null,pageIndex: 1,pageSize: 50,totalCount: 0 }

           const state = Vue.reactive({
                qry:  JSON.parse(JSON.stringify( qry)),
                dataList: []
            });
      
           Vue.onMounted(() => { loadData()  });

            const loadData = () => {
                axios.post(`/sysuser/PageList`, {...state.qry}).then(response => {
                    let {data,status}=response;
                    state.dataList = data.data.list;
                    state.qry.totalCount = data.data.total;
                })
            };

            const handleSizeChange = (val) => {
                    state.qry.pageIndex = 1;
                    state.qry.pageSize = val;
                    loadData();
            };
            const handleCurrentChange = (val) => {
                    state.qry.pageIndex = val;
                    loadData();
           };

           /**
            * 新增
            */
           const onNew = () => {
                    layer.open({
                        type: 2,
                        title: '新增',
                        area: ['600px', '480px'],
                        fix: false,
                        maxmin: true,
                        content:  "/SysUser/AddEditMgr?id=0",
                        end: function () {
                           state.qry.pageIndex = 1;
                           loadData();
                        }
                    });
           };

          /**
            * 编辑
            */
           const onEdit=(row)=>{
                    layer.open({
                        type: 2,
                        title: '编辑',
                        area: ['600px', '480px'],
                        fix: false,
                        maxmin: true,
                        content:  "/SysUser/AddEditMgr?id="+row.id,
                        end: function () {
                           loadData();
                        }
                    });
            }


            /**
             * 重置密码
             */
            const onResetPassword = (row)=>{
                 ElMessageBox.confirm('您确定将用户【'+row.realName+'】密码重置为【123456】吗?', { confirmButtonText: '确定', cancelButtonText: '取消', type: 'warning', }).then(() => {

                         axios.put(`/sysuser/${row.id}/resetPassword`).then(res  => {
                                      top.window.vueElMessage({ message: res.data. message , type:  res.data.isSuccess?'success':'info' })
                        })
                 })
            }


            const onDelete =  (row) => {

                  ElMessageBox.confirm('您确定删除吗?', { confirmButtonText: '确定', cancelButtonText: '取消', type: 'warning', }).then(() => {

                         axios.delete(`/sysuser/${row.id}/delete`).then(res  => {
                                          top.window.vueElMessage({ message: res.data. message , type:  res.data.isSuccess?'success':'info' })
                                          if(res.data.isSuccess){
                                             loadData();
                                          }
                        })
                 })
            }

            //重置查询表单
            const resetQueryForm=()=>{
                state.qry  = JSON.parse(JSON.stringify( qry))
             };

            return {
                state
                ,loadData
                ,handleSizeChange
                ,handleCurrentChange
                ,onDelete
                ,resetQueryForm
                ,onNew
                ,onEdit
                ,onResetPassword
                };
               }
            });
            app.use(ElementPlus,{ locale: ElementPlusLocaleZhCn });
            app.mount('#app');
    </script>

}